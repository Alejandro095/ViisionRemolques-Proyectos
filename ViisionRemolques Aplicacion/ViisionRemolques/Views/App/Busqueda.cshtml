@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Búsqueda";
}

@section Metatags {
    <link rel="stylesheet" href="~/assets/css/animated.css" />

    <style>
        /* La página no usa la barra superior del master */
        #kt_app_toolbar {
            display: none !important;
        }
    </style>

    <!--begin::Búsqueda-->
    <style>
        /* ---------- Tokens locales (respetan claro/oscuro de Metronic) ---------- */
        :root {
            --vp-gap: 14px;
            --vp-radio: 14px;
            --vp-video-bg: #0d0d16;
            --vp-panel-bg: var(--bs-body-bg);
            --vp-panel-borde: var(--bs-border-color);
            --vp-sombra: 0 1px 2px rgba(20, 20, 31, 0.06), 0 8px 24px rgba(20, 20, 31, 0.05);
            --vp-acento: var(--bs-primary);
            --vp-lateral-ancho: 320px;
            /* Alto de la miniatura de cada resultado */
            --bq-miniatura-alto: clamp(96px, 14vh, 140px);
        }

        [data-bs-theme="dark"] {
            --vp-video-bg: #08080f;
            --vp-sombra: 0 1px 2px rgba(0, 0, 0, 0.35), 0 8px 24px rgba(0, 0, 0, 0.25);
        }

        html,
        body {
            height: 100%;
            overflow: hidden;
        }

        #kt_app_root,
        #kt_app_page,
        #kt_app_wrapper,
        #kt_app_main,
        #kt_app_main > .flex-column-fluid,
        #kt_app_content,
        #kt_app_content_container {
            height: 100%;
            min-height: 0;
        }

        #kt_app_main {
            margin: 0 !important;
        }

        #kt_app_content_container {
            display: flex;
            flex-direction: column;
            padding: 12px !important;
        }

        [hidden] {
            display: none !important;
        }

        /* ---------- Estructura general ---------- */
        .vp-layout {
            display: flex;
            gap: var(--vp-gap);
            height: 100%;
            min-height: 0;
        }

        .vp-principal {
            flex: 1 1 auto;
            min-width: 0;
            min-height: 0;
            display: flex;
            flex-direction: column;
            gap: var(--vp-gap);
        }

        .vp-lateral {
            flex: 0 0 var(--vp-lateral-ancho);
            width: var(--vp-lateral-ancho);
            display: flex;
            flex-direction: column;
            gap: var(--vp-gap);
            min-height: 0;
        }

        /* ---------- Tarjeta genérica ---------- */
        .vp-panel {
            background-color: var(--vp-panel-bg);
            border: 1px solid var(--vp-panel-borde);
            border-radius: var(--vp-radio);
            box-shadow: var(--vp-sombra);
            overflow: hidden;
        }

        .vp-panel-encabezado {
            display: flex;
            align-items: center;
            gap: 0.6rem;
            padding: 0.7rem 0.9rem;
        }

        .vp-panel-titulo {
            font-size: 0.6875rem;
            font-weight: 700;
            letter-spacing: 0.8px;
            text-transform: uppercase;
            color: var(--bs-gray-500);
            margin: 0;
        }

        .vp-seccion-subtitulo {
            font-size: 0.625rem;
            font-weight: 700;
            letter-spacing: 0.7px;
            text-transform: uppercase;
            color: var(--bs-gray-500);
        }

        /* ---------- Botonera genérica (misma que en cámaras) ---------- */
        .vp-btn-control {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.35rem;
            border: 1px solid var(--vp-panel-borde);
            border-radius: 9px;
            background-color: var(--bs-gray-100);
            color: var(--bs-gray-700);
            font-size: 0.75rem;
            font-weight: 600;
            padding: 0;
            transition: background-color 0.12s ease, color 0.12s ease, border-color 0.12s ease;
        }

            .vp-btn-control:hover:not(:disabled),
            .vp-btn-control:hover:not(:disabled) i {
                background-color: var(--vp-acento);
                border-color: var(--vp-acento);
                color: #ffffff;
            }

            .vp-btn-control:active:not(:disabled) {
                transform: scale(0.94);
            }

            .vp-btn-control:disabled {
                opacity: 0.4;
            }

        .vp-toggle {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            height: 32px;
            padding: 0 0.6rem;
            border: 1px solid var(--vp-panel-borde);
            border-radius: 8px;
            background-color: var(--bs-gray-100);
            color: var(--bs-gray-700);
            font-size: 0.6875rem;
            font-weight: 600;
            white-space: nowrap;
            overflow: hidden;
            transition: background-color 0.12s ease, color 0.12s ease, border-color 0.12s ease;
        }

            .vp-toggle:hover:not(:disabled),
            .vp-toggle:hover:not(:disabled) i {
                border-color: var(--vp-acento);
                color: var(--vp-acento);
            }

            .vp-toggle.activo {
                background-color: rgba(var(--bs-success-rgb), 0.12);
                border-color: rgba(var(--bs-success-rgb), 0.45);
                color: var(--bs-success);
            }

                .vp-toggle.activo i {
                    color: var(--bs-success);
                }

            .vp-toggle:disabled {
                opacity: 0.4;
            }

            .vp-toggle i {
                flex-shrink: 0;
            }

        .vp-seccion-aviso {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.6rem 0.85rem;
            border: 1px dashed var(--vp-panel-borde);
            border-radius: 9px;
            background-color: var(--vp-panel-bg);
            font-size: 0.75rem;
            font-weight: 500;
            color: var(--bs-gray-700);
        }

        /* ---------- Buscador ---------- */
        .bq-buscador {
            flex: 0 0 auto;
        }

        .bq-marca {
            display: inline-flex;
            align-items: center;
            gap: 0.3rem;
            padding: 0.15rem 0.5rem;
            border-radius: 999px;
            background-color: rgba(var(--bs-primary-rgb), 0.1);
            color: var(--vp-acento);
            font-size: 0.6875rem;
            font-weight: 700;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .bq-buscador-cuerpo {
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
            padding: 0 0.9rem 0.9rem;
        }

        .bq-categorias {
            display: flex;
            gap: 0.4rem;
            flex-wrap: wrap;
        }

        .bq-categoria {
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
            height: 30px;
            padding: 0 0.75rem;
            border: 1px solid var(--vp-panel-borde);
            border-radius: 999px;
            background-color: var(--bs-gray-100);
            color: var(--bs-gray-700);
            font-size: 0.75rem;
            font-weight: 600;
            white-space: nowrap;
            transition: background-color 0.12s ease, color 0.12s ease, border-color 0.12s ease;
        }

            .bq-categoria:hover,
            .bq-categoria:hover i {
                border-color: var(--vp-acento);
                color: var(--vp-acento);
            }

            .bq-categoria.activo {
                background-color: rgba(var(--bs-primary-rgb), 0.1);
                border-color: rgba(var(--bs-primary-rgb), 0.4);
                color: var(--vp-acento);
            }

                .bq-categoria.activo i {
                    color: var(--vp-acento);
                }

            .bq-categoria i {
                flex-shrink: 0;
            }

        .bq-consulta {
            display: flex;
            gap: 0.5rem;
        }

        .bq-campo {
            flex: 1 1 auto;
            min-width: 0;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            height: 42px;
            padding: 0 0.85rem;
            border: 1px solid var(--vp-panel-borde);
            border-radius: 10px;
            background-color: var(--bs-gray-100);
            color: var(--bs-gray-500);
            transition: border-color 0.15s ease, box-shadow 0.15s ease;
        }

            .bq-campo:focus-within {
                border-color: rgba(var(--bs-primary-rgb), 0.6);
                box-shadow: 0 0 0 3px rgba(var(--bs-primary-rgb), 0.12);
            }

            .bq-campo input {
                flex: 1 1 auto;
                min-width: 0;
                border: 0;
                background-color: transparent;
                color: var(--bs-gray-900);
                font-size: 0.875rem;
                font-weight: 500;
                outline: none;
            }

                .bq-campo input::placeholder {
                    color: var(--bs-gray-500);
                    font-weight: 400;
                }

        .bq-campo-limpiar {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 24px;
            height: 24px;
            flex-shrink: 0;
            border: 0;
            border-radius: 50%;
            background-color: transparent;
            color: var(--bs-gray-500);
            transition: background-color 0.12s ease, color 0.12s ease;
        }

            .bq-campo-limpiar:hover {
                background-color: var(--bs-gray-200);
                color: var(--bs-danger);
            }

        .bq-btn-primario {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.45rem;
            height: 42px;
            padding: 0 1.35rem;
            border: 0;
            border-radius: 10px;
            background-color: var(--vp-acento);
            color: #ffffff;
            font-size: 0.8125rem;
            font-weight: 600;
            letter-spacing: 0.2px;
            white-space: nowrap;
            transition: filter 0.12s ease, transform 0.12s ease;
        }

            .bq-btn-primario:hover:not(:disabled) {
                filter: brightness(1.1);
            }

            .bq-btn-primario:active:not(:disabled) {
                transform: scale(0.97);
            }

            .bq-btn-primario:disabled {
                opacity: 0.45;
            }

        .bq-btn-sm {
            height: 30px;
            padding: 0 0.8rem;
            border-radius: 8px;
            font-size: 0.6875rem;
        }

        /* ---------- Filtros ---------- */
        .bq-filtros {
            display: flex;
            align-items: center;
            gap: 0.9rem;
            flex-wrap: wrap;
        }

        .bq-grupo {
            display: inline-flex;
            gap: 2px;
            padding: 2px;
            border: 1px solid var(--vp-panel-borde);
            border-radius: 9px;
            background-color: var(--bs-gray-100);
        }

        .bq-grupo-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            height: 26px;
            padding: 0 0.7rem;
            border: 0;
            border-radius: 7px;
            background-color: transparent;
            color: var(--bs-gray-600);
            font-size: 0.75rem;
            font-weight: 600;
            white-space: nowrap;
            transition: background-color 0.12s ease, color 0.12s ease;
        }

            .bq-grupo-btn:hover {
                color: var(--vp-acento);
            }

            .bq-grupo-btn.activo {
                background-color: var(--vp-panel-bg);
                color: var(--vp-acento);
                box-shadow: 0 1px 2px rgba(20, 20, 31, 0.12);
            }

        .bq-fechas {
            display: flex;
            align-items: center;
            gap: 0.4rem;
        }

            .bq-fechas label {
                display: inline-flex;
                align-items: center;
                gap: 0.3rem;
                margin: 0;
                font-size: 0.625rem;
                font-weight: 700;
                letter-spacing: 0.6px;
                text-transform: uppercase;
                color: var(--bs-gray-500);
            }

            .bq-fechas input {
                height: 30px;
                padding: 0 0.5rem;
                border: 1px solid var(--vp-panel-borde);
                border-radius: 8px;
                background-color: var(--bs-gray-100);
                color: var(--bs-gray-800);
                font-size: 0.75rem;
                font-weight: 600;
                color-scheme: light dark;
            }

        .bq-canales {
            position: relative;
        }

            .bq-canales > summary {
                list-style: none;
                cursor: pointer;
            }

                .bq-canales > summary::-webkit-details-marker {
                    display: none;
                }

                .bq-canales > summary::marker {
                    content: "";
                }

            .bq-canales[open] > summary .vp-toggle,
            .bq-canales[open] > summary .vp-toggle i {
                border-color: var(--vp-acento);
                color: var(--vp-acento);
            }

        .bq-canales-lista {
            position: absolute;
            z-index: 6;
            top: calc(100% + 6px);
            left: 0;
            width: 240px;
            max-height: 240px;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 0.1rem;
            padding: 0.5rem;
            border: 1px solid var(--vp-panel-borde);
            border-radius: 10px;
            background-color: var(--vp-panel-bg);
            box-shadow: var(--vp-sombra);
        }

            .bq-canales-lista .bq-check {
                padding: 0.3rem 0.35rem;
                border-radius: 7px;
            }

                .bq-canales-lista .bq-check:hover {
                    background-color: var(--bs-gray-100);
                }

            .bq-canales-lista hr {
                margin: 0.3rem 0;
                border-top: 1px dashed var(--vp-panel-borde);
                opacity: 1;
            }

        .bq-check {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            margin: 0;
            font-size: 0.75rem;
            font-weight: 600;
            color: var(--bs-gray-700);
            white-space: nowrap;
            cursor: pointer;
        }

            .bq-check input[type="checkbox"] {
                width: 15px;
                height: 15px;
                flex-shrink: 0;
                accent-color: var(--vp-acento);
                cursor: pointer;
            }

        .bq-similitud {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            margin: 0;
            font-size: 0.6875rem;
            font-weight: 700;
            letter-spacing: 0.4px;
            text-transform: uppercase;
            color: var(--bs-gray-500);
        }

            .bq-similitud b {
                color: var(--vp-acento);
            }

            .bq-similitud input[type="range"] {
                -webkit-appearance: none;
                appearance: none;
                width: 120px;
                height: 16px;
                margin: 0;
                background: transparent;
                cursor: pointer;
            }

                .bq-similitud input[type="range"]::-webkit-slider-runnable-track {
                    height: 6px;
                    border-radius: 999px;
                    background: linear-gradient(to right, var(--vp-acento) 0 var(--vp-relleno, 60%), var(--vp-panel-borde) var(--vp-relleno, 60%) 100%);
                }

                .bq-similitud input[type="range"]::-webkit-slider-thumb {
                    -webkit-appearance: none;
                    appearance: none;
                    width: 14px;
                    height: 14px;
                    margin-top: -4px;
                    border: 0;
                    border-radius: 50%;
                    background-color: var(--vp-acento);
                }

                .bq-similitud input[type="range"]::-moz-range-track {
                    height: 6px;
                    border-radius: 999px;
                    background-color: var(--vp-panel-borde);
                }

                .bq-similitud input[type="range"]::-moz-range-progress {
                    height: 6px;
                    border-radius: 999px;
                    background-color: var(--vp-acento);
                }

                .bq-similitud input[type="range"]::-moz-range-thumb {
                    width: 14px;
                    height: 14px;
                    border: 0;
                    border-radius: 50%;
                    background-color: var(--vp-acento);
                }

        /* ---------- Favoritos e historial ---------- */
        .bq-historial {
            display: flex;
            flex-direction: column;
            gap: 0.4rem;
            padding-top: 0.75rem;
            border-top: 1px dashed var(--vp-panel-borde);
        }

        .bq-historial-fila {
            display: flex;
            align-items: center;
            gap: 0.6rem;
            min-height: 26px;
        }

            .bq-historial-fila > .vp-seccion-subtitulo {
                flex: 0 0 76px;
                display: inline-flex;
                align-items: center;
                gap: 0.25rem;
            }

        .bq-chips {
            display: flex;
            align-items: center;
            gap: 0.35rem;
            flex-wrap: wrap;
            min-width: 0;
        }

        .bq-chip {
            display: inline-flex;
            align-items: center;
            gap: 0.25rem;
            height: 24px;
            padding: 0 0.25rem 0 0.6rem;
            border: 1px solid var(--vp-panel-borde);
            border-radius: 999px;
            background-color: transparent;
            color: var(--bs-gray-700);
            font-size: 0.6875rem;
            font-weight: 600;
            transition: background-color 0.12s ease, border-color 0.12s ease;
        }

            .bq-chip:hover {
                border-color: rgba(var(--bs-primary-rgb), 0.45);
                background-color: rgba(var(--bs-primary-rgb), 0.06);
            }

            .bq-chip.favorito {
                border-color: rgba(var(--bs-warning-rgb), 0.45);
                background-color: rgba(var(--bs-warning-rgb), 0.08);
                color: var(--bs-warning);
            }

        .bq-chip-texto {
            max-width: 210px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            border: 0;
            padding: 0;
            background-color: transparent;
            color: inherit;
            font: inherit;
            cursor: pointer;
        }

        .bq-chip-x {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 17px;
            height: 17px;
            flex-shrink: 0;
            border: 0;
            border-radius: 50%;
            background-color: transparent;
            color: var(--bs-gray-500);
            transition: background-color 0.12s ease, color 0.12s ease;
        }

            .bq-chip-x:hover {
                background-color: rgba(var(--bs-danger-rgb), 0.14);
                color: var(--bs-danger);
            }

        .bq-chips-vacio {
            font-size: 0.6875rem;
            font-weight: 500;
            color: var(--bs-gray-500);
        }

        /* ---------- Resultados ---------- */
        .bq-resultados {
            flex: 1 1 auto;
            min-height: 0;
            display: flex;
            flex-direction: column;
        }

        .bq-barra {
            flex-wrap: wrap;
            row-gap: 0.5rem;
            border-bottom: 1px solid var(--vp-panel-borde);
        }

        .bq-resumen {
            font-size: 0.6875rem;
            font-weight: 600;
            color: var(--bs-gray-600);
            white-space: nowrap;
        }

        .bq-aviso {
            display: flex;
            align-items: center;
            gap: 0.6rem;
            margin: 0.7rem 0.9rem 0;
            padding: 0.5rem 0.75rem;
            border: 1px dashed rgba(var(--bs-primary-rgb), 0.45);
            border-radius: 10px;
            background-color: rgba(var(--bs-primary-rgb), 0.06);
            font-size: 0.75rem;
            font-weight: 500;
            color: var(--bs-gray-700);
        }

            .bq-aviso b {
                color: var(--vp-acento);
            }

        .bq-progreso {
            display: flex;
            align-items: center;
            gap: 0.7rem;
            margin: 0.7rem 0.9rem 0;
        }

        .bq-progreso-barra {
            flex: 1 1 auto;
            height: 6px;
            border-radius: 999px;
            background-color: var(--bs-gray-200);
            overflow: hidden;
        }

        .bq-progreso-relleno {
            display: block;
            height: 100%;
            width: 0;
            border-radius: 999px;
            background-color: var(--vp-acento);
            transition: width 0.25s ease;
        }

        .bq-progreso-texto {
            font-size: 0.6875rem;
            font-weight: 700;
            color: var(--bs-gray-600);
            white-space: nowrap;
        }

        .bq-enlace {
            border: 0;
            padding: 0;
            background-color: transparent;
            color: var(--vp-acento);
            font-size: 0.6875rem;
            font-weight: 700;
            white-space: nowrap;
        }

            .bq-enlace:hover {
                text-decoration: underline;
            }

        .bq-grid {
            flex: 1 1 auto;
            min-height: 0;
            overflow-y: auto;
            display: grid;
            gap: var(--vp-gap);
            grid-template-columns: repeat(auto-fill, minmax(178px, 1fr));
            grid-auto-rows: max-content;
            align-content: start;
            padding: 0.9rem;
        }

        .bq-tarjeta {
            position: relative;
            min-width: 0;
            border-radius: var(--vp-radio);
            overflow: hidden;
            background-color: var(--vp-video-bg);
            border: 2px solid var(--vp-panel-borde);
            box-shadow: var(--vp-sombra);
            cursor: pointer;
            transition: border-color 0.15s ease, box-shadow 0.15s ease;
        }

            .bq-tarjeta:hover {
                border-color: rgba(var(--bs-primary-rgb), 0.45);
            }

            .bq-tarjeta.seleccionada {
                border-color: var(--vp-acento);
            }

        .bq-tarjeta-lienzo {
            position: relative;
            line-height: 0;
        }

        .bq-tarjeta-img {
            display: block;
            width: 100%;
            height: var(--bq-miniatura-alto);
            object-fit: cover;
            background-color: var(--vp-video-bg);
        }

        .bq-tarjeta-sim {
            position: absolute;
            top: 0.45rem;
            left: 0.45rem;
            z-index: 2;
            padding: 0.1rem 0.45rem;
            border-radius: 999px;
            background-color: rgba(var(--bs-primary-rgb), 0.9);
            color: #ffffff;
            font-size: 0.625rem;
            font-weight: 700;
            letter-spacing: 0.3px;
            line-height: 1.6;
        }

        .bq-tarjeta-marcar {
            position: absolute;
            top: 0.45rem;
            right: 0.45rem;
            z-index: 3;
            width: 16px;
            height: 16px;
            accent-color: var(--vp-acento);
            cursor: pointer;
        }

        .bq-tarjeta-barra {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            z-index: 2;
            display: flex;
            align-items: center;
            gap: 0.4rem;
            padding: 1.6rem 0.6rem 0.5rem;
            pointer-events: none;
            background: linear-gradient(0deg, rgba(8, 8, 15, 0.88) 0%, rgba(8, 8, 15, 0.68) 34%, rgba(8, 8, 15, 0.3) 68%, rgba(8, 8, 15, 0) 100%);
        }

        .bq-tarjeta-categoria {
            display: inline-flex;
            align-items: center;
            gap: 0.25rem;
            padding: 0.1rem 0.4rem;
            border-radius: 6px;
            background-color: rgba(255, 255, 255, 0.16);
            color: #ffffff;
            font-size: 0.5625rem;
            font-weight: 700;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .bq-tarjeta-duracion {
            margin-left: auto;
            color: rgba(255, 255, 255, 0.85);
            font-size: 0.625rem;
            font-weight: 700;
            text-shadow: 0 1px 3px rgba(8, 8, 15, 0.6);
            white-space: nowrap;
        }

        .bq-tarjeta-meta {
            display: flex;
            flex-direction: column;
            gap: 0.1rem;
            padding: 0.45rem 0.6rem 0.5rem;
            background-color: var(--vp-panel-bg);
        }

        .bq-tarjeta-canal {
            font-size: 0.75rem;
            font-weight: 600;
            color: var(--bs-gray-900);
            line-height: 1.25;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .bq-tarjeta-fecha {
            font-size: 0.625rem;
            font-weight: 500;
            color: var(--bs-gray-500);
            line-height: 1.25;
        }

        .bq-tarjeta-etiquetas {
            display: none;
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .bq-grid[data-tuning="true"] .bq-tarjeta-etiquetas {
            display: grid;
        }

        .bq-etiqueta {
            height: 28px;
            border: 0;
            border-top: 1px solid var(--vp-panel-borde);
            background-color: var(--bs-gray-100);
            color: var(--bs-gray-600);
            font-size: 0.625rem;
            font-weight: 700;
            transition: background-color 0.12s ease, color 0.12s ease;
        }

            .bq-etiqueta + .bq-etiqueta {
                border-left: 1px solid var(--vp-panel-borde);
            }

            .bq-etiqueta:hover {
                color: var(--bs-gray-900);
            }

            .bq-etiqueta.positiva.activo {
                background-color: rgba(var(--bs-success-rgb), 0.16);
                color: var(--bs-success);
            }

            .bq-etiqueta.negativa.activo {
                background-color: rgba(var(--bs-danger-rgb), 0.16);
                color: var(--bs-danger);
            }

        .bq-vacio {
            grid-column: 1 / -1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            padding: 2.5rem 1rem;
            color: var(--bs-gray-500);
            text-align: center;
        }

            .bq-vacio span {
                font-size: 0.8125rem;
                font-weight: 600;
            }

            .bq-vacio small {
                max-width: 320px;
                font-size: 0.6875rem;
                font-weight: 500;
            }

        .bq-pager {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.6rem;
            padding: 0.55rem;
            border-top: 1px solid var(--vp-panel-borde);
        }

        .bq-pager-btn {
            width: 30px;
            height: 30px;
        }

        .bq-pager-info {
            min-width: 128px;
            font-size: 0.6875rem;
            font-weight: 600;
            color: var(--bs-gray-600);
            text-align: center;
        }

        /* ---------- Detalle lateral ---------- */
        .bq-detalle {
            flex: 1 1 auto;
            min-height: 0;
            display: flex;
            flex-direction: column;
            position: relative;
        }

        .bq-detalle-badge {
            flex-shrink: 0;
            padding: 0.15rem 0.5rem;
            border-radius: 6px;
            background-color: rgba(var(--bs-success-rgb), 0.12);
            color: var(--bs-success);
            font-size: 0.625rem;
            font-weight: 700;
            letter-spacing: 0.5px;
            text-transform: uppercase;
        }

        .bq-detalle[data-activo="false"] .bq-detalle-badge {
            background-color: var(--bs-gray-200);
            color: var(--bs-gray-500);
        }

        .bq-detalle[data-activo="false"] .bq-detalle-cuerpo {
            display: none;
        }

        .bq-detalle-aviso {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            z-index: 3;
            display: none;
            max-width: calc(100% - 2rem);
            box-shadow: var(--vp-sombra);
            pointer-events: none;
        }

        .bq-detalle[data-activo="false"] .bq-detalle-aviso {
            display: flex;
        }

        .bq-detalle-cuerpo {
            flex: 1 1 auto;
            min-height: 0;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 0.8rem;
            padding: 0 1rem 1rem;
        }

        .bq-marco {
            position: relative;
            border-radius: 10px;
            overflow: hidden;
            background-color: var(--vp-video-bg);
            line-height: 0;
        }

            .bq-marco img {
                display: block;
                width: 100%;
            }

        .bq-objetivo {
            position: absolute;
            border: 2px solid #00e676;
            border-radius: 3px;
            box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.5);
            pointer-events: none;
        }

        .bq-marco-barra {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            display: flex;
            align-items: center;
            gap: 0.4rem;
            padding: 1.9rem 0.7rem 0.55rem;
            pointer-events: none;
            background: linear-gradient(0deg, rgba(8, 8, 15, 0.88) 0%, rgba(8, 8, 15, 0.6) 40%, rgba(8, 8, 15, 0) 100%);
            color: #ffffff;
            font-size: 0.75rem;
            font-weight: 600;
            line-height: 1.3;
        }

        .bq-marco-reloj {
            margin-left: auto;
            color: rgba(255, 255, 255, 0.85);
            font-size: 0.6875rem;
            font-weight: 700;
        }

        .bq-clip {
            display: flex;
            flex-direction: column;
            gap: 0.45rem;
        }

        .bq-clip-barra {
            height: 4px;
            border-radius: 999px;
            background-color: var(--bs-gray-200);
            overflow: hidden;
        }

        .bq-clip-relleno {
            display: block;
            height: 100%;
            width: 0;
            border-radius: 999px;
            background-color: var(--vp-acento);
        }

        .bq-detalle-acciones {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 0.4rem;
        }

            .bq-detalle-acciones .vp-btn-control {
                height: 32px;
            }

        .bq-detalle-tabla {
            width: 100%;
            font-size: 0.75rem;
        }

            .bq-detalle-tabla td {
                padding: 0.22rem 0.1rem;
                vertical-align: top;
            }

                .bq-detalle-tabla td:first-child {
                    width: 96px;
                    color: var(--bs-gray-500);
                    font-weight: 600;
                }

                .bq-detalle-tabla td:last-child {
                    color: var(--bs-gray-800);
                    font-weight: 600;
                }

        .bq-nota {
            font-size: 0.6875rem;
            font-weight: 500;
            color: var(--bs-gray-500);
            line-height: 1.5;
        }

        .bq-divisor {
            padding-top: 0.75rem;
            border-top: 1px dashed var(--vp-panel-borde);
        }

        @@media (max-width: 1500px) {
            :root {
                --vp-lateral-ancho: 280px;
            }

            .bq-grid {
                grid-template-columns: repeat(auto-fill, minmax(158px, 1fr));
            }
        }

        @@media (max-width: 1200px) {
            html,
            body {
                overflow: auto;
            }

            .vp-layout {
                flex-direction: column;
                height: auto;
            }

            .vp-lateral {
                flex: 0 0 auto;
                width: 100%;
            }

            .bq-detalle {
                flex: 0 0 auto;
            }

            .bq-grid {
                max-height: 60vh;
            }
        }
    </style>
    <!--end::Búsqueda-->
}

<div class="vp-layout">
    <!--begin::Columna principal-->
    <div class="vp-principal">
        <!--begin::Buscador-->
        <section class="vp-panel bq-buscador">
            <div class="vp-panel-encabezado">
                <h4 class="vp-panel-titulo">Búsqueda de video por lenguaje natural</h4>
                <span class="bq-marca ms-auto">
                    <i class="ki-outline ki-magnifier fs-8"></i>
                    AcuSeek
                </span>
            </div>

            <div class="bq-buscador-cuerpo">
                <!--begin::Categorías-->
                <div class="bq-categorias" id="categorias"></div>
                <!--end::Categorías-->

                <!--begin::Consulta-->
                <div class="bq-consulta">
                    <div class="bq-campo">
                        <i class="ki-outline ki-magnifier fs-5"></i>
                        <input type="text" id="consulta" autocomplete="off"
                               placeholder="Describe lo que buscas, ej. &quot;una persona con ropa roja&quot;"
                               aria-label="Consulta de búsqueda" />
                        <button type="button" class="bq-campo-limpiar" id="btn-limpiar" title="Limpiar consulta" hidden>
                            <i class="ki-outline ki-cross fs-6"></i>
                        </button>
                    </div>
                    <button type="button" class="bq-btn-primario" id="btn-buscar">
                        <i class="ki-outline ki-magnifier fs-6"></i>
                        Buscar
                    </button>
                </div>
                <!--end::Consulta-->

                <!--begin::Filtros-->
                <div class="bq-filtros">
                    <div class="bq-grupo" id="rango">
                        <button type="button" class="bq-grupo-btn activo" data-rango="hoy">Hoy</button>
                        <button type="button" class="bq-grupo-btn" data-rango="3d">3 días</button>
                        <button type="button" class="bq-grupo-btn" data-rango="7d">7 días</button>
                        <button type="button" class="bq-grupo-btn" data-rango="personalizado">Personalizado</button>
                    </div>

                    <div class="bq-fechas" id="fechas" hidden>
                        <label for="fecha-inicio">Desde <input type="datetime-local" id="fecha-inicio" /></label>
                        <label for="fecha-fin">Hasta <input type="datetime-local" id="fecha-fin" /></label>
                    </div>

                    <details class="bq-canales" id="canales">
                        <summary>
                            <span class="vp-toggle">
                                <i class="ki-outline ki-screen fs-6"></i>
                                <span>Canales (<span id="canales-conteo">todos</span>)</span>
                                <i class="ki-outline ki-down fs-8"></i>
                            </span>
                        </summary>
                        <div class="bq-canales-lista">
                            <label class="bq-check">
                                <input type="checkbox" id="canales-todos" checked />
                                Todos los canales
                            </label>
                            <hr />
                            <div id="canales-lista"></div>
                        </div>
                    </details>

                    <label class="bq-similitud" for="similitud">
                        <span>Similitud <b id="similitud-valor">60</b>%</span>
                        <input type="range" id="similitud" min="0" max="100" step="5" value="60"
                               aria-label="Umbral de similitud" />
                    </label>
                </div>
                <!--end::Filtros-->

                <!--begin::Favoritos e historial-->
                <div class="bq-historial">
                    <div class="bq-historial-fila">
                        <span class="vp-seccion-subtitulo">
                            <i class="ki-outline ki-star fs-8"></i>
                            Favoritos
                        </span>
                        <div class="bq-chips" id="favoritos-chips"></div>
                    </div>
                    <div class="bq-historial-fila">
                        <span class="vp-seccion-subtitulo">
                            <i class="ki-outline ki-time fs-8"></i>
                            Historial
                        </span>
                        <div class="bq-chips" id="historial-chips"></div>
                    </div>
                </div>
                <!--end::Favoritos e historial-->
            </div>
        </section>
        <!--end::Buscador-->

        <!--begin::Resultados-->
        <section class="vp-panel bq-resultados">
            <div class="vp-panel-encabezado bq-barra">
                <h4 class="vp-panel-titulo">Resultados</h4>
                <span class="bq-resumen" id="resumen">Sin búsquedas todavía</span>

                <div class="ms-auto d-flex align-items-center gap-2">
                    <label class="bq-check" title="Seleccionar todos los resultados de la página">
                        <input type="checkbox" id="marcar-todo" />
                        Seleccionar todo
                    </label>

                    <button type="button" class="vp-toggle" id="btn-favorito" title="Guardar esta consulta en favoritos" disabled>
                        <i class="ki-outline ki-star fs-6"></i>
                        Favorito
                    </button>

                    <button type="button" class="vp-toggle" id="btn-exportar" title="Exportar resultados a CSV" disabled>
                        <i class="ki-outline ki-exit-down fs-6"></i>
                        Exportar CSV
                    </button>

                    <button type="button" class="vp-toggle" id="btn-tuning" title="Etiquetar resultados para reentrenar" disabled>
                        <i class="ki-outline ki-teacher fs-6"></i>
                        Tuning
                    </button>
                </div>
            </div>

            <div class="bq-aviso" id="tuning-aviso" hidden>
                <i class="ki-outline ki-information-2 fs-5"></i>
                <span>
                    Etiqueta al menos <b>4 correctas</b> y <b>6 incorrectas</b> —
                    <b id="tuning-correctas">0</b> correctas / <b id="tuning-incorrectas">0</b> incorrectas
                </span>
                <button type="button" class="bq-btn-primario bq-btn-sm ms-auto" id="tuning-enviar" disabled>
                    Enviar tuning
                </button>
            </div>

            <div class="bq-progreso" id="progreso" hidden>
                <span class="bq-progreso-texto" id="progreso-texto">Buscando…</span>
                <span class="bq-progreso-barra"><span class="bq-progreso-relleno" id="progreso-relleno"></span></span>
                <button type="button" class="bq-enlace" id="btn-cancelar">Cancelar</button>
            </div>

            <div class="bq-grid" id="grid" data-tuning="false"></div>

            <div class="bq-pager" id="pager" hidden>
                <button type="button" class="vp-btn-control bq-pager-btn" id="pagina-anterior" title="Página anterior">
                    <i class="ki-outline ki-left fs-6"></i>
                </button>
                <span class="bq-pager-info" id="pagina-info"></span>
                <button type="button" class="vp-btn-control bq-pager-btn" id="pagina-siguiente" title="Página siguiente">
                    <i class="ki-outline ki-right fs-6"></i>
                </button>
            </div>
        </section>
        <!--end::Resultados-->
    </div>
    <!--end::Columna principal-->

    <!--begin::Lateral: detalle del resultado-->
    <aside class="vp-lateral">
        <div class="vp-panel bq-detalle" id="detalle" data-activo="false">
            <div class="vp-panel-encabezado">
                <h4 class="vp-panel-titulo">Detalle</h4>
                <span class="bq-detalle-badge" id="detalle-badge">Sin selección</span>
            </div>

            <div class="vp-seccion-aviso bq-detalle-aviso">
                <i class="ki-outline ki-information-2 fs-5"></i>
                <span>Selecciona un resultado para ver su detalle.</span>
            </div>

            <div class="bq-detalle-cuerpo">
                <div class="bq-marco" id="detalle-marco">
                    <img id="detalle-imagen" alt="Cuadro del resultado seleccionado" />
                    <span class="bq-objetivo" id="detalle-objetivo"></span>
                    <div class="bq-marco-barra">
                        <span id="detalle-canal">—</span>
                        <span class="bq-marco-reloj" id="detalle-reloj">—</span>
                    </div>
                </div>

                <div class="bq-clip">
                    <button type="button" class="vp-btn-control" id="detalle-reproducir" style="height: 34px;">
                        <i class="fas fa-play"></i>
                        Reproducir clip
                    </button>
                    <span class="bq-clip-barra"><span class="bq-clip-relleno" id="detalle-clip-relleno"></span></span>
                </div>

                <div class="bq-detalle-acciones">
                    <button type="button" class="vp-btn-control" id="detalle-descargar">
                        <i class="ki-outline ki-exit-down fs-6"></i>
                        Descargar
                    </button>
                    <button type="button" class="vp-btn-control" id="detalle-copiar">
                        <i class="ki-outline ki-copy fs-6"></i>
                        Copiar ID
                    </button>
                </div>

                <table class="bq-detalle-tabla">
                    <tbody id="detalle-tabla"></tbody>
                </table>

                <p class="bq-nota bq-divisor" id="detalle-nota"></p>
            </div>
        </div>
    </aside>
    <!--end::Lateral-->
</div>

@section Scripts {
    <script>
        /* ---------- Catálogos ---------- */
        const CANALES = {
            camara_1: "Cámara 1 · Frontal",
            camara_2: "Cámara 2 · Lateral",
            camara_3: "Cámara 3 · Trasera",
            camara_4: "Cámara 4 · Interior",
            camara_5: "Cámara 5 · Patio",
            camara_6: "Cámara 6 · Acceso"
        };

        const CATEGORIAS = [
            { clave: "persona", etiqueta: "Persona", icono: "ki-outline ki-profile-circle", consulta: "una persona con ropa roja" },
            { clave: "vehiculo", etiqueta: "Vehículo", icono: "fas fa-car", consulta: "un vehículo blanco estacionado" },
            { clave: "nmv", etiqueta: "NMV", icono: "fas fa-bicycle", consulta: "una bicicleta cruzando el acceso" },
            { clave: "objeto", etiqueta: "Objeto", icono: "ki-outline ki-package", consulta: "una caja abandonada en el piso" },
            { clave: "animal", etiqueta: "Animal", icono: "fas fa-paw", consulta: "un perro suelto" }
        ];

        const ATRIBUTOS = {
            persona: ["ropa roja", "mochila", "casco", "chaleco reflectante", "sin casco", "gorra"],
            vehiculo: ["color blanco", "camioneta", "placa visible", "puerta abierta", "remolque", "sedán"],
            nmv: ["bicicleta", "motocicleta", "patín", "sin luces", "dos ocupantes"],
            objeto: ["caja", "maleta", "tarima", "herramienta", "objeto abandonado"],
            animal: ["perro", "gato", "ave", "animal suelto"]
        };

        const POR_PAGINA = 12;
        const TUNING_MINIMO_CORRECTAS = 4;
        const TUNING_MINIMO_INCORRECTAS = 6;
        const MODO_PRUEBAS = true;

        function TextoHtml(valor) {
            return String(valor ?? "").replace(/[&<>"]/g, caracter => ({
                "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;"
            }[caracter]));
        }

        function Aleatorio(minimo, maximo) {
            return Math.floor(Math.random() * (maximo - minimo + 1)) + minimo;
        }

        function FechaTexto(fecha) {
            return typeof dayjs === "function"
                ? dayjs(fecha).format("DD/MM/YYYY HH:mm:ss")
                : fecha.toLocaleString("es-MX");
        }

        function HoraTexto(fecha) {
            return typeof dayjs === "function"
                ? dayjs(fecha).format("HH:mm:ss")
                : fecha.toLocaleTimeString("es-MX");
        }

        function DuracionTexto(segundos) {
            const minutos = Math.floor(segundos / 60);
            return `${minutos}:${String(segundos % 60).padStart(2, "0")}`;
        }
    </script>

    <script>
        (function () {
            /* ---------- Referencias ---------- */
            const contenedorCategorias = document.getElementById("categorias");
            const consulta = document.getElementById("consulta");
            const btnLimpiar = document.getElementById("btn-limpiar");
            const btnBuscar = document.getElementById("btn-buscar");

            const rango = document.getElementById("rango");
            const fechas = document.getElementById("fechas");
            const fechaInicio = document.getElementById("fecha-inicio");
            const fechaFin = document.getElementById("fecha-fin");

            const canales = document.getElementById("canales");
            const canalesLista = document.getElementById("canales-lista");
            const canalesTodos = document.getElementById("canales-todos");
            const canalesConteo = document.getElementById("canales-conteo");

            const similitud = document.getElementById("similitud");
            const similitudValor = document.getElementById("similitud-valor");

            const favoritosChips = document.getElementById("favoritos-chips");
            const historialChips = document.getElementById("historial-chips");

            const resumen = document.getElementById("resumen");
            const marcarTodo = document.getElementById("marcar-todo");
            const btnFavorito = document.getElementById("btn-favorito");
            const btnExportar = document.getElementById("btn-exportar");
            const btnTuning = document.getElementById("btn-tuning");

            const tuningAviso = document.getElementById("tuning-aviso");
            const tuningCorrectas = document.getElementById("tuning-correctas");
            const tuningIncorrectas = document.getElementById("tuning-incorrectas");
            const tuningEnviar = document.getElementById("tuning-enviar");

            const progreso = document.getElementById("progreso");
            const progresoTexto = document.getElementById("progreso-texto");
            const progresoRelleno = document.getElementById("progreso-relleno");
            const btnCancelar = document.getElementById("btn-cancelar");

            const grid = document.getElementById("grid");
            const pager = document.getElementById("pager");
            const paginaInfo = document.getElementById("pagina-info");
            const paginaAnterior = document.getElementById("pagina-anterior");
            const paginaSiguiente = document.getElementById("pagina-siguiente");

            const detalle = document.getElementById("detalle");
            const detalleBadge = document.getElementById("detalle-badge");
            const detalleImagen = document.getElementById("detalle-imagen");
            const detalleObjetivo = document.getElementById("detalle-objetivo");
            const detalleCanal = document.getElementById("detalle-canal");
            const detalleReloj = document.getElementById("detalle-reloj");
            const detalleTabla = document.getElementById("detalle-tabla");
            const detalleNota = document.getElementById("detalle-nota");
            const detalleReproducir = document.getElementById("detalle-reproducir");
            const detalleClipRelleno = document.getElementById("detalle-clip-relleno");
            const detalleDescargar = document.getElementById("detalle-descargar");
            const detalleCopiar = document.getElementById("detalle-copiar");

            /* ---------- Estado ---------- */
            const estado = {
                resultados: [],
                pagina: 1,
                seleccionado: null,
                marcados: new Set(),
                etiquetas: new Map(),
                consultaUsada: "",
                categoria: null,
                buscando: false
            };

            const ALMACEN_FAVORITOS = "bq-favoritos";
            const ALMACEN_HISTORIAL = "bq-historial";

            function Leer(clave) {
                try {
                    const valor = JSON.parse(localStorage.getItem(clave) ?? "[]");
                    return Array.isArray(valor) ? valor : [];
                } catch {
                    return [];
                }
            }

            function Guardar(clave, valor) {
                try {
                    localStorage.setItem(clave, JSON.stringify(valor));
                } catch {
                    /* sin almacenamiento disponible */
                }
            }

            let favoritos = Leer(ALMACEN_FAVORITOS);
            let historial = Leer(ALMACEN_HISTORIAL);

            /* ---------- Categorías ---------- */
            contenedorCategorias.innerHTML = CATEGORIAS.map(categoria => `
                <button type="button" class="bq-categoria" data-categoria="${categoria.clave}"
                    data-consulta="${TextoHtml(categoria.consulta)}">
                    <i class="${categoria.icono} fs-7"></i>
                    ${TextoHtml(categoria.etiqueta)}
                </button>`).join("");

            contenedorCategorias.querySelectorAll(".bq-categoria").forEach(boton => {
                boton.addEventListener("click", () => {
                    const activa = boton.classList.contains("activo");

                    contenedorCategorias.querySelectorAll(".bq-categoria")
                        .forEach(el => el.classList.toggle("activo", el === boton && !activa));

                    estado.categoria = activa ? null : boton.dataset.categoria;

                    if (!activa) {
                        consulta.value = boton.dataset.consulta;
                        PintarLimpiar();
                        consulta.focus();
                    }
                });
            });

            /* ---------- Canales ---------- */
            canalesLista.innerHTML = Object.entries(CANALES).map(([clave, nombre]) => `
                <label class="bq-check">
                    <input type="checkbox" value="${clave}" checked />
                    ${TextoHtml(nombre)}
                </label>`).join("");

            const canalesCheck = [...canalesLista.querySelectorAll("input[type='checkbox']")];

            function CanalesElegidos() {
                return canalesCheck.filter(el => el.checked).map(el => el.value);
            }

            function PintarCanales() {
                const elegidos = CanalesElegidos();

                canalesTodos.checked = elegidos.length === canalesCheck.length;
                canalesTodos.indeterminate = elegidos.length > 0 && elegidos.length < canalesCheck.length;

                canalesConteo.innerText = elegidos.length === canalesCheck.length
                    ? "todos"
                    : elegidos.length === 0 ? "ninguno" : String(elegidos.length);
            }

            canalesCheck.forEach(check => check.addEventListener("change", PintarCanales));

            canalesTodos.addEventListener("change", () => {
                canalesCheck.forEach(check => check.checked = canalesTodos.checked);
                PintarCanales();
            });

            document.addEventListener("click", evento => {
                if (canales.open && !canales.contains(evento.target)) canales.open = false;
            });

            PintarCanales();

            /* ---------- Rango de fechas ---------- */
            rango.querySelectorAll(".bq-grupo-btn").forEach(boton => {
                boton.addEventListener("click", () => {
                    rango.querySelectorAll(".bq-grupo-btn")
                        .forEach(el => el.classList.toggle("activo", el === boton));

                    fechas.hidden = boton.dataset.rango !== "personalizado";
                });
            });

            function RangoElegido() {
                return rango.querySelector(".bq-grupo-btn.activo")?.dataset.rango ?? "hoy";
            }

            function RangoTexto() {
                const elegido = RangoElegido();

                if (elegido === "personalizado") {
                    const desde = fechaInicio.value ? FechaTexto(new Date(fechaInicio.value)) : "—";
                    const hasta = fechaFin.value ? FechaTexto(new Date(fechaFin.value)) : "—";
                    return `${desde} a ${hasta}`;
                }

                return { hoy: "Hoy", "3d": "Últimos 3 días", "7d": "Últimos 7 días" }[elegido];
            }

            function RangoDias() {
                const elegido = RangoElegido();

                if (elegido === "3d") return 3;
                if (elegido === "7d") return 7;
                if (elegido === "personalizado") return 14;

                return 1;
            }

            /* ---------- Similitud ---------- */
            function PintarSimilitud() {
                const recorrido = (similitud.value - similitud.min) / (similitud.max - similitud.min);

                similitud.style.setProperty("--vp-relleno", `${recorrido * 100}%`);
                similitudValor.innerText = similitud.value;
            }

            similitud.addEventListener("input", PintarSimilitud);
            PintarSimilitud();

            /* ---------- Campo de consulta ---------- */
            function PintarLimpiar() {
                btnLimpiar.hidden = consulta.value.trim().length === 0;
            }

            consulta.addEventListener("input", PintarLimpiar);

            consulta.addEventListener("keydown", evento => {
                if (evento.key !== "Enter") return;

                evento.preventDefault();
                Buscar();
            });

            btnLimpiar.addEventListener("click", () => {
                consulta.value = "";
                PintarLimpiar();
                consulta.focus();
            });

            /* ---------- Favoritos e historial ---------- */
            function ChipHtml(texto, esFavorito) {
                return `
                    <span class="bq-chip${esFavorito ? " favorito" : ""}">
                        <button type="button" class="bq-chip-texto" title="${TextoHtml(texto)}">${TextoHtml(texto)}</button>
                        <button type="button" class="bq-chip-x" title="Quitar">
                            <i class="ki-outline ki-cross fs-8"></i>
                        </button>
                    </span>`;
            }

            function PintarChips(contenedor, valores, esFavorito) {
                if (valores.length === 0) {
                    contenedor.innerHTML = `<span class="bq-chips-vacio">${esFavorito ? "Aún no guardas consultas." : "Sin búsquedas recientes."}</span>`;
                    return;
                }

                contenedor.innerHTML = valores.map(valor => ChipHtml(valor, esFavorito)).join("");

                contenedor.querySelectorAll(".bq-chip").forEach((chip, indice) => {
                    chip.querySelector(".bq-chip-texto").addEventListener("click", () => {
                        consulta.value = valores[indice];
                        PintarLimpiar();
                        Buscar();
                    });

                    chip.querySelector(".bq-chip-x").addEventListener("click", () => {
                        if (esFavorito) {
                            favoritos = favoritos.filter(valor => valor !== valores[indice]);
                            Guardar(ALMACEN_FAVORITOS, favoritos);
                        } else {
                            historial = historial.filter(valor => valor !== valores[indice]);
                            Guardar(ALMACEN_HISTORIAL, historial);
                        }

                        PintarHistorial();
                    });
                });
            }

            function PintarHistorial() {
                PintarChips(favoritosChips, favoritos, true);
                PintarChips(historialChips, historial, false);
                PintarFavorito();
            }

            function PintarFavorito() {
                const texto = estado.consultaUsada;

                btnFavorito.disabled = texto.length === 0;
                btnFavorito.classList.toggle("activo", texto.length > 0 && favoritos.includes(texto));
            }

            btnFavorito.addEventListener("click", () => {
                const texto = estado.consultaUsada;
                if (!texto) return;

                favoritos = favoritos.includes(texto)
                    ? favoritos.filter(valor => valor !== texto)
                    : [texto, ...favoritos].slice(0, 8);

                Guardar(ALMACEN_FAVORITOS, favoritos);
                PintarHistorial();
            });

            PintarHistorial();

            /* ---------- Generación de resultados (modo pruebas) ---------- */
            function ResultadosSimulados(texto, filtro) {
                const total = Aleatorio(0, 46);
                const dias = RangoDias();
                const ahora = Date.now();
                const categoria = estado.categoria ?? CATEGORIAS[Aleatorio(0, CATEGORIAS.length - 1)].clave;

                return Array.from({ length: total }, (_, indice) => {
                    const clave = filtro.canales[Aleatorio(0, filtro.canales.length - 1)];
                    const fecha = new Date(ahora - Aleatorio(0, dias * 86400) * 1000);
                    const atributos = ATRIBUTOS[categoria] ?? ATRIBUTOS.objeto;

                    return {
                        id: `EV-${String(ahora).slice(-6)}${String(indice).padStart(2, "0")}`,
                        canal: clave,
                        canalNombre: CANALES[clave],
                        categoria: categoria,
                        similitud: Aleatorio(filtro.similitud, 99),
                        fecha: fecha,
                        duracion: Aleatorio(4, 42),
                        miniatura: `/assets/media/stock/600x400/img-${Aleatorio(1, 80)}.jpg`,
                        atributos: [...new Set([
                            atributos[Aleatorio(0, atributos.length - 1)],
                            atributos[Aleatorio(0, atributos.length - 1)]
                        ])],
                        objetivo: {
                            izquierda: Aleatorio(8, 60),
                            arriba: Aleatorio(8, 55),
                            ancho: Aleatorio(16, 32),
                            alto: Aleatorio(20, 38)
                        }
                    };
                }).sort((uno, otro) => otro.similitud - uno.similitud);
            }

            async function ResultadosDeApi(texto, filtro) {
                const respuesta = await FetchUtils("busqueda", {
                    method: "POST",
                    body: JSON.stringify({
                        Consulta: texto,
                        Categoria: estado.categoria,
                        Canales: filtro.canales,
                        Similitud: filtro.similitud,
                        Rango: RangoElegido(),
                        Desde: fechaInicio.value || null,
                        Hasta: fechaFin.value || null
                    })
                });

                if (!respuesta || !respuesta.Ok || !respuesta.Respuesta) return [];

                return respuesta.Respuesta.map(elemento => ({
                    id: elemento.Id,
                    canal: elemento.Canal,
                    canalNombre: CANALES[elemento.Canal] ?? elemento.Canal,
                    categoria: elemento.Categoria,
                    similitud: Math.round(elemento.Similitud),
                    fecha: new Date(elemento.Fecha),
                    duracion: elemento.Duracion ?? 0,
                    miniatura: elemento.Miniatura,
                    atributos: elemento.Atributos ?? [],
                    objetivo: elemento.Objetivo ?? { izquierda: 30, arriba: 30, ancho: 24, alto: 28 }
                })).sort((uno, otro) => otro.similitud - uno.similitud);
            }

            /* ---------- Búsqueda ---------- */
            let cancelada = false;

            function MostrarProgreso(mostrar) {
                progreso.hidden = !mostrar;
                progresoRelleno.style.width = mostrar ? "8%" : "0";
            }

            async function Buscar() {
                const texto = consulta.value.trim();

                if (!texto) {
                    resumen.innerText = "Escribe qué quieres buscar";
                    consulta.focus();
                    return;
                }

                const elegidos = CanalesElegidos();

                if (elegidos.length === 0) {
                    resumen.innerText = "Selecciona al menos un canal";
                    canales.open = true;
                    return;
                }

                if (estado.buscando) return;

                const filtro = { canales: elegidos, similitud: Number(similitud.value) };

                estado.buscando = true;
                cancelada = false;

                btnBuscar.disabled = true;
                progresoTexto.innerText = "Buscando…";
                MostrarProgreso(true);
                resumen.innerText = `“${texto}” · ${RangoTexto()}`;

                const inicio = performance.now();
                let avance = 8;

                const temporizador = setInterval(() => {
                    avance = Math.min(avance + Aleatorio(6, 18), 92);
                    progresoRelleno.style.width = `${avance}%`;
                }, 160);

                let resultados = [];

                try {
                    if (MODO_PRUEBAS) {
                        await new Promise(resolver => setTimeout(resolver, Aleatorio(700, 1500)));
                        resultados = cancelada ? [] : ResultadosSimulados(texto, filtro);
                    } else {
                        resultados = await ResultadosDeApi(texto, filtro);
                    }
                } catch (error) {
                    console.error("Falló la búsqueda", error);
                    resumen.innerText = "No se pudo completar la búsqueda";
                } finally {
                    clearInterval(temporizador);
                    progresoRelleno.style.width = "100%";

                    setTimeout(() => MostrarProgreso(false), 260);

                    btnBuscar.disabled = false;
                    estado.buscando = false;
                }

                if (cancelada) {
                    resumen.innerText = "Búsqueda cancelada";
                    return;
                }

                const segundos = ((performance.now() - inicio) / 1000).toFixed(2);

                estado.resultados = resultados;
                estado.pagina = 1;
                estado.seleccionado = null;
                estado.marcados.clear();
                estado.etiquetas.clear();
                estado.consultaUsada = texto;

                historial = [texto, ...historial.filter(valor => valor !== texto)].slice(0, 8);
                Guardar(ALMACEN_HISTORIAL, historial);
                PintarHistorial();

                resumen.innerText = `${resultados.length} resultado${resultados.length === 1 ? "" : "s"} · ${RangoTexto()} · ${segundos} s`;

                PintarResultados();
                PintarDetalle(null);
            }

            btnBuscar.addEventListener("click", Buscar);

            btnCancelar.addEventListener("click", () => {
                cancelada = true;
                progresoTexto.innerText = "Cancelando…";
            });

            /* ---------- Pintado de resultados ---------- */
            function TarjetaHtml(resultado) {
                const categoria = CATEGORIAS.find(el => el.clave === resultado.categoria);

                return `
                    <article class="bq-tarjeta" data-id="${TextoHtml(resultado.id)}">
                        <div class="bq-tarjeta-lienzo">
                            <img class="bq-tarjeta-img" src="${TextoHtml(resultado.miniatura)}"
                                alt="Coincidencia en ${TextoHtml(resultado.canalNombre)}" loading="lazy" />
                            <span class="bq-tarjeta-sim">${resultado.similitud}%</span>
                            <input type="checkbox" class="bq-tarjeta-marcar" title="Marcar resultado"
                                aria-label="Marcar resultado" />
                            <div class="bq-tarjeta-barra">
                                <span class="bq-tarjeta-categoria">${TextoHtml(categoria?.etiqueta ?? resultado.categoria)}</span>
                                <span class="bq-tarjeta-duracion">${DuracionTexto(resultado.duracion)}</span>
                            </div>
                        </div>

                        <div class="bq-tarjeta-meta">
                            <span class="bq-tarjeta-canal">${TextoHtml(resultado.canalNombre)}</span>
                            <span class="bq-tarjeta-fecha">${FechaTexto(resultado.fecha)}</span>
                        </div>

                        <div class="bq-tarjeta-etiquetas">
                            <button type="button" class="bq-etiqueta positiva" data-etiqueta="correcta">Correcta</button>
                            <button type="button" class="bq-etiqueta negativa" data-etiqueta="incorrecta">Incorrecta</button>
                        </div>
                    </article>`;
            }

            function VacioHtml() {
                const sinBusqueda = estado.consultaUsada.length === 0;

                return `
                    <div class="bq-vacio">
                        <i class="ki-outline ki-${sinBusqueda ? "magnifier" : "filter-search"} fs-3x"></i>
                        <span>${sinBusqueda ? "Describe lo que buscas" : "Sin coincidencias"}</span>
                        <small>${sinBusqueda
                            ? "Escribe una frase en lenguaje natural o elige una categoría para empezar."
                            : "Prueba con otra frase, baja el umbral de similitud o amplía el rango de fechas."}</small>
                    </div>`;
            }

            function Paginas() {
                return Math.max(Math.ceil(estado.resultados.length / POR_PAGINA), 1);
            }

            function ResultadosDePagina() {
                const desde = (estado.pagina - 1) * POR_PAGINA;
                return estado.resultados.slice(desde, desde + POR_PAGINA);
            }

            function PintarResultados() {
                const pagina = ResultadosDePagina();

                grid.innerHTML = pagina.length === 0 ? VacioHtml() : pagina.map(TarjetaHtml).join("");

                pager.hidden = estado.resultados.length <= POR_PAGINA;
                paginaInfo.innerText = `Página ${estado.pagina} de ${Paginas()} · ${estado.resultados.length} eventos`;
                paginaAnterior.disabled = estado.pagina <= 1;
                paginaSiguiente.disabled = estado.pagina >= Paginas();

                const hayResultados = estado.resultados.length > 0;

                btnExportar.disabled = !hayResultados;
                btnTuning.disabled = !hayResultados;

                if (!hayResultados && btnTuning.classList.contains("activo")) AlternarTuning(false);

                grid.querySelectorAll(".bq-tarjeta").forEach(tarjeta => {
                    const id = tarjeta.dataset.id;
                    const resultado = estado.resultados.find(el => el.id === id);

                    tarjeta.classList.toggle("seleccionada", estado.seleccionado === id);

                    const marcar = tarjeta.querySelector(".bq-tarjeta-marcar");
                    marcar.checked = estado.marcados.has(id);

                    marcar.addEventListener("click", evento => evento.stopPropagation());

                    marcar.addEventListener("change", () => {
                        if (marcar.checked) estado.marcados.add(id);
                        else estado.marcados.delete(id);

                        PintarMarcarTodo();
                    });

                    tarjeta.addEventListener("click", () => {
                        estado.seleccionado = id;

                        grid.querySelectorAll(".bq-tarjeta")
                            .forEach(el => el.classList.toggle("seleccionada", el === tarjeta));

                        PintarDetalle(resultado);
                    });

                    tarjeta.querySelectorAll(".bq-etiqueta").forEach(boton => {
                        const etiqueta = boton.dataset.etiqueta;

                        boton.classList.toggle("activo", estado.etiquetas.get(id) === etiqueta);

                        boton.addEventListener("click", evento => {
                            evento.stopPropagation();

                            if (estado.etiquetas.get(id) === etiqueta) estado.etiquetas.delete(id);
                            else estado.etiquetas.set(id, etiqueta);

                            tarjeta.querySelectorAll(".bq-etiqueta").forEach(el => {
                                el.classList.toggle("activo", estado.etiquetas.get(id) === el.dataset.etiqueta);
                            });

                            PintarTuning();
                        });
                    });
                });

                PintarMarcarTodo();
                PintarFavorito();
            }

            function PintarMarcarTodo() {
                const pagina = ResultadosDePagina();
                const marcados = pagina.filter(resultado => estado.marcados.has(resultado.id)).length;

                marcarTodo.checked = pagina.length > 0 && marcados === pagina.length;
                marcarTodo.indeterminate = marcados > 0 && marcados < pagina.length;
            }

            marcarTodo.addEventListener("change", () => {
                ResultadosDePagina().forEach(resultado => {
                    if (marcarTodo.checked) estado.marcados.add(resultado.id);
                    else estado.marcados.delete(resultado.id);
                });

                grid.querySelectorAll(".bq-tarjeta").forEach(tarjeta => {
                    tarjeta.querySelector(".bq-tarjeta-marcar").checked = estado.marcados.has(tarjeta.dataset.id);
                });
            });

            paginaAnterior.addEventListener("click", () => {
                if (estado.pagina <= 1) return;

                estado.pagina -= 1;
                PintarResultados();
                grid.scrollTo({ top: 0, behavior: "smooth" });
            });

            paginaSiguiente.addEventListener("click", () => {
                if (estado.pagina >= Paginas()) return;

                estado.pagina += 1;
                PintarResultados();
                grid.scrollTo({ top: 0, behavior: "smooth" });
            });

            /* ---------- Detalle ---------- */
            let clipEnCurso = null;

            function PintarDetalle(resultado) {
                if (clipEnCurso) {
                    clearInterval(clipEnCurso);
                    clipEnCurso = null;
                }

                detalleClipRelleno.style.width = "0";
                detalleReproducir.querySelector("i").className = "fas fa-play";

                if (!resultado) {
                    detalle.dataset.activo = "false";
                    detalleBadge.innerText = "Sin selección";
                    return;
                }

                const categoria = CATEGORIAS.find(el => el.clave === resultado.categoria);

                detalle.dataset.activo = "true";
                detalleBadge.innerText = `${resultado.similitud}% similitud`;

                detalleImagen.src = resultado.miniatura;
                detalleImagen.alt = `Cuadro de ${resultado.canalNombre}`;
                detalleCanal.innerText = resultado.canalNombre;
                detalleReloj.innerText = HoraTexto(resultado.fecha);

                detalleObjetivo.style.left = `${resultado.objetivo.izquierda}%`;
                detalleObjetivo.style.top = `${resultado.objetivo.arriba}%`;
                detalleObjetivo.style.width = `${resultado.objetivo.ancho}%`;
                detalleObjetivo.style.height = `${resultado.objetivo.alto}%`;

                const filas = [
                    ["Evento", resultado.id],
                    ["Canal", resultado.canalNombre],
                    ["Categoría", categoria?.etiqueta ?? resultado.categoria],
                    ["Fecha", FechaTexto(resultado.fecha)],
                    ["Duración", DuracionTexto(resultado.duracion)],
                    ["Similitud", `${resultado.similitud}%`],
                    ["Atributos", resultado.atributos.join(", ") || "—"]
                ];

                detalleTabla.innerHTML = filas.map(([campo, valor]) => `
                    <tr>
                        <td>${TextoHtml(campo)}</td>
                        <td>${TextoHtml(valor)}</td>
                    </tr>`).join("");

                detalleNota.innerText = `Coincidencia obtenida con la consulta “${estado.consultaUsada}”. `
                    + "El recuadro verde señala el objeto detectado dentro del cuadro.";
            }

            detalleReproducir.addEventListener("click", () => {
                if (detalle.dataset.activo !== "true") return;

                if (clipEnCurso) {
                    clearInterval(clipEnCurso);
                    clipEnCurso = null;
                    detalleReproducir.querySelector("i").className = "fas fa-play";
                    return;
                }

                let avance = 0;
                detalleReproducir.querySelector("i").className = "fas fa-pause";

                clipEnCurso = setInterval(() => {
                    avance += 2;
                    detalleClipRelleno.style.width = `${Math.min(avance, 100)}%`;

                    if (avance < 100) return;

                    clearInterval(clipEnCurso);
                    clipEnCurso = null;
                    detalleReproducir.querySelector("i").className = "fas fa-play";
                }, 60);
            });

            detalleDescargar.addEventListener("click", () => {
                const resultado = estado.resultados.find(el => el.id === estado.seleccionado);
                if (!resultado) return;

                const enlace = document.createElement("a");
                enlace.href = resultado.miniatura;
                enlace.download = `${resultado.id}.jpg`;
                enlace.click();
            });

            detalleCopiar.addEventListener("click", async () => {
                if (!estado.seleccionado) return;

                try {
                    await navigator.clipboard.writeText(estado.seleccionado);
                    detalleCopiar.classList.add("activo");
                    setTimeout(() => detalleCopiar.classList.remove("activo"), 900);
                } catch {
                    console.warn("El navegador no permitió copiar al portapapeles.");
                }
            });

            /* ---------- Exportar CSV ---------- */
            btnExportar.addEventListener("click", () => {
                const elegidos = estado.marcados.size > 0
                    ? estado.resultados.filter(resultado => estado.marcados.has(resultado.id))
                    : estado.resultados;

                if (elegidos.length === 0) return;

                const columnas = ["Evento", "Canal", "Categoria", "Fecha", "Duracion", "Similitud", "Atributos"];

                const filas = elegidos.map(resultado => [
                    resultado.id,
                    resultado.canalNombre,
                    resultado.categoria,
                    FechaTexto(resultado.fecha),
                    DuracionTexto(resultado.duracion),
                    `${resultado.similitud}%`,
                    resultado.atributos.join(" | ")
                ]);

                const csv = [columnas, ...filas]
                    .map(fila => fila.map(celda => `"${String(celda).replace(/"/g, '""')}"`).join(";"))
                    .join("\r\n");

                const enlace = document.createElement("a");
                enlace.href = URL.createObjectURL(new Blob(["\uFEFF" + csv], { type: "text/csv;charset=utf-8;" }));
                enlace.download = `busqueda-${Date.now()}.csv`;
                enlace.click();

                setTimeout(() => URL.revokeObjectURL(enlace.href), 1000);
            });

            /* ---------- Tuning ---------- */
            function Conteos() {
                const valores = [...estado.etiquetas.values()];

                return {
                    correctas: valores.filter(valor => valor === "correcta").length,
                    incorrectas: valores.filter(valor => valor === "incorrecta").length
                };
            }

            function PintarTuning() {
                const { correctas, incorrectas } = Conteos();

                tuningCorrectas.innerText = correctas;
                tuningIncorrectas.innerText = incorrectas;
                tuningEnviar.disabled = correctas < TUNING_MINIMO_CORRECTAS || incorrectas < TUNING_MINIMO_INCORRECTAS;
            }

            function AlternarTuning(activar) {
                btnTuning.classList.toggle("activo", activar);
                grid.dataset.tuning = activar ? "true" : "false";
                tuningAviso.hidden = !activar;

                if (!activar) {
                    estado.etiquetas.clear();
                    grid.querySelectorAll(".bq-etiqueta").forEach(el => el.classList.remove("activo"));
                }

                PintarTuning();
            }

            btnTuning.addEventListener("click", () => AlternarTuning(!btnTuning.classList.contains("activo")));

            tuningEnviar.addEventListener("click", () => {
                const { correctas, incorrectas } = Conteos();

                resumen.innerText = `Tuning enviado · ${correctas} correctas / ${incorrectas} incorrectas`;
                AlternarTuning(false);
            });

            PintarTuning();

            /* ---------- Estado inicial ---------- */
            PintarResultados();
            PintarDetalle(null);
            consulta.focus();
        })();
    </script>
}
