@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Centinela";
}

@section Metatags {
    <link rel="stylesheet" href="~/assets/css/animated.css" />

    <style>
        /* La página no usa la barra superior del master */
        #kt_app_toolbar {
            display: none !important;
        }
    </style>

    <!--begin::Videowall-->
    <style>
        /* ---------- Tokens locales (respetan claro/oscuro de Metronic) ---------- */
        :root {
            --vp-gap: 14px;
            --vp-radio: 14px;
            --vp-video-bg: #0d0d16;
            --vp-panel-bg: var(--bs-body-bg);
            --vp-panel-borde: var(--bs-border-color);
            --vp-sombra: 0 1px 2px rgba(20, 20, 31, 0.06), 0 8px 24px rgba(20, 20, 31, 0.05);
            --vp-acento: var(--bs-primary);
            --vp-lateral-ancho: 320px;
            /* Alto de la tira de cámaras pequeñas de la vista previa */
            --vp-tira-alto: clamp(84px, 19vh, 170px);
            /* Tope de alto del listado lateral */
            --vp-lista-alto: clamp(180px, 36vh, 380px);
        }

        [data-bs-theme="dark"] {
            --vp-video-bg: #08080f;
            --vp-sombra: 0 1px 2px rgba(0, 0, 0, 0.35), 0 8px 24px rgba(0, 0, 0, 0.25);
        }

        html,
        body {
            height: 100%;
            overflow: hidden;
        }

        #kt_app_root,
        #kt_app_page,
        #kt_app_wrapper,
        #kt_app_main,
        #kt_app_main > .flex-column-fluid,
        #kt_app_content,
        #kt_app_content_container {
            height: 100%;
            min-height: 0;
        }

        #kt_app_main {
            margin: 0 !important;
        }

        #kt_app_content_container {
            display: flex;
            flex-direction: column;
            padding: 12px !important;
        }

        /* ---------- Estructura general ---------- */
        .vp-layout {
            display: flex;
            gap: var(--vp-gap);
            height: 100%;
            min-height: 0;
        }

        .vp-principal {
            flex: 1 1 auto;
            min-width: 0;
            min-height: 0;
            display: flex;
            flex-direction: column;
            gap: var(--vp-gap);
        }

        .vp-lateral {
            flex: 0 0 var(--vp-lateral-ancho);
            width: var(--vp-lateral-ancho);
            display: flex;
            flex-direction: column;
            gap: var(--vp-gap);
            min-height: 0;
        }

        /* ---------- Tarjeta genérica ---------- */
        .vp-panel {
            background-color: var(--vp-panel-bg);
            border: 1px solid var(--vp-panel-borde);
            border-radius: var(--vp-radio);
            box-shadow: var(--vp-sombra);
            overflow: hidden;
        }

        .vp-panel-encabezado {
            display: flex;
            align-items: center;
            gap: 0.6rem;
            padding: 0.7rem 0.9rem;
        }

        .vp-panel-titulo {
            font-size: 0.6875rem;
            font-weight: 700;
            letter-spacing: 0.8px;
            text-transform: uppercase;
            color: var(--bs-gray-500);
            margin: 0;
        }

        /* ---------- Visor ---------- */
        .vp-visor {
            flex: 1 1 auto;
            min-height: 0;
            display: grid;
            gap: var(--vp-gap);
            grid-template-columns: 1fr;
            grid-template-rows: 1fr;
        }

            .vp-visor[data-vista="unica"] .vp-celda {
                display: none;
            }

                .vp-visor[data-vista="unica"] .vp-celda.seleccionada {
                    display: block;
                }

            .vp-visor[data-vista="previa"] {
                grid-template-columns: repeat(var(--vp-tira, 1), minmax(0, 1fr));
                grid-template-rows: 1fr var(--vp-tira-alto);
                gap: 0;
                overflow: hidden;
                border: 2px solid var(--vp-panel-borde);
                border-radius: var(--vp-radio);
                box-shadow: var(--vp-sombra);
            }

                .vp-visor[data-vista="previa"] .vp-celda {
                    grid-row: 2;
                    border-radius: 0;
                    box-shadow: none;
                    border-color: transparent;
                }

                .vp-visor[data-vista="previa"] .vp-celda.seleccionada {
                    grid-row: 1;
                    grid-column: 1 / -1;
                }

        .vp-celda {
            position: relative;
            overflow: hidden;
            min-width: 0;
            min-height: 0;
            border-radius: var(--vp-radio);
            background-color: var(--vp-video-bg);
            border: 2px solid var(--vp-panel-borde);
            box-shadow: var(--vp-sombra);
            transition: border-color 0.15s ease, box-shadow 0.15s ease;
        }

            .vp-celda video-stream {
                position: absolute;
                inset: 0;
                display: block;
                background-color: var(--vp-video-bg);
            }

                .vp-celda video-stream video {
                    width: 100%;
                    height: 100%;
                    display: block;
                }

                .vp-celda video-stream .info {
                    display: none !important;
                }

            .vp-celda video::-webkit-media-controls {
                display: none !important;
            }

        .vp-celda-capa {
            position: absolute;
            inset: 0;
            z-index: 1;
        }

        .vp-visor[data-vista="previa"] .vp-celda-capa {
            cursor: pointer;
        }

        .vp-visor[data-vista="previa"] .vp-celda:not(.seleccionada):hover {
            border-color: rgba(var(--bs-primary-rgb), 0.45);
        }

        .vp-visor[data-vista="previa"] .vp-celda:not(.seleccionada) .vp-celda-barra {
            padding: 1.9rem 0.7rem 0.6rem;
        }

        .vp-visor[data-vista="previa"] .vp-celda:not(.seleccionada) .vp-celda-nombre {
            font-size: 0.8125rem;
        }

        .vp-visor[data-vista="previa"] .vp-celda:not(.seleccionada) .vp-celda-num {
            width: 22px;
            height: 22px;
            font-size: 0.75rem;
        }

        .vp-visor[data-vista="previa"] .vp-celda:not(.seleccionada) .vp-celda-acciones {
            opacity: 0;
            transition: opacity 0.15s ease;
        }

        .vp-visor[data-vista="previa"] .vp-celda:not(.seleccionada):hover .vp-celda-acciones {
            opacity: 1;
        }

        .vp-celda:fullscreen {
            border: 0;
            border-radius: 0;
            box-shadow: none;
        }

        .vp-celda.vp-capturando::after {
            content: "";
            position: absolute;
            inset: 0;
            z-index: 3;
            pointer-events: none;
            background-color: #ffffff;
            animation: vp-destello 0.35s ease-out;
        }

        @@keyframes vp-destello {
            from { opacity: 0.28; }
            to { opacity: 0; }
        }

        .vp-celda-vacia {
            position: absolute;
            inset: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            color: rgba(255, 255, 255, 0.28);
            pointer-events: none;
        }

        .vp-celda-barra {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            z-index: 2;
            display: flex;
            align-items: center;
            gap: 0.6rem;
            padding: 2.5rem 1rem 0.85rem;
            pointer-events: none;
            background: linear-gradient(0deg, rgba(8, 8, 15, 0.88) 0%, rgba(8, 8, 15, 0.72) 30%, rgba(8, 8, 15, 0.38) 62%, rgba(8, 8, 15, 0.12) 84%, rgba(8, 8, 15, 0) 100%);
        }

        .vp-celda-num {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 26px;
            height: 26px;
            border-radius: 8px;
            background-color: rgba(255, 255, 255, 0.16);
            color: #ffffff;
            font-size: 0.8125rem;
            font-weight: 700;
            line-height: 1;
            flex-shrink: 0;
        }

        .vp-celda-nombre {
            color: #ffffff;
            font-size: 0.9375rem;
            font-weight: 600;
            letter-spacing: 0.2px;
            text-shadow: 0 1px 3px rgba(8, 8, 15, 0.6);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .vp-celda-acciones {
            margin-left: auto;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            pointer-events: auto;
        }

        .vp-celda-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 30px;
            height: 30px;
            border: 0;
            border-radius: 8px;
            background-color: rgba(255, 255, 255, 0.12);
            color: #ffffff;
            transition: background-color 0.15s ease;
        }

            .vp-celda-btn:hover {
                background-color: rgba(255, 255, 255, 0.24);
            }

        .vp-celda-volumen {
            display: flex;
            align-items: center;
            gap: 0.4rem;
        }

        .vp-celda-volumen-barra {
            width: 0;
            opacity: 0;
            margin: 0;
            padding: 0;
            cursor: pointer;
            accent-color: var(--vp-acento);
            transition: width 0.15s ease, opacity 0.15s ease;
        }

        .vp-celda-volumen:hover .vp-celda-volumen-barra,
        .vp-celda-volumen:focus-within .vp-celda-volumen-barra {
            width: 72px;
            opacity: 1;
        }

        .vp-celda[data-audio="false"] .vp-celda-volumen {
            display: none;
        }

        .vp-vivo {
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
            padding: 0.2rem 0.55rem;
            border-radius: 999px;
            background-color: rgba(241, 65, 108, 0.18);
            border: 1px solid rgba(241, 65, 108, 0.45);
            color: #ff7096;
            font-size: 0.6875rem;
            font-weight: 700;
            letter-spacing: 0.6px;
            text-transform: uppercase;
            white-space: nowrap;
            flex-shrink: 0;
        }

            .vp-vivo[data-estado="conectando"],
            .vp-vivo[data-estado="cargando"] {
                background-color: rgba(var(--bs-warning-rgb), 0.18);
                border-color: rgba(var(--bs-warning-rgb), 0.5);
                color: var(--bs-warning);
            }

            .vp-vivo[data-estado="pausado"],
            .vp-vivo[data-estado="detenido"] {
                background-color: rgba(255, 255, 255, 0.12);
                border-color: rgba(255, 255, 255, 0.35);
                color: rgba(255, 255, 255, 0.8);
            }

            .vp-vivo[data-estado="error"] {
                background-color: rgba(var(--bs-danger-rgb), 0.9);
                border-color: rgba(var(--bs-danger-rgb), 0.9);
                color: #ffffff;
            }

        /* ---------- Conmutador de vista ---------- */
        .vp-vista-toggle {
            display: inline-flex;
            gap: 2px;
            padding: 2px;
            border: 1px solid var(--vp-panel-borde);
            border-radius: 9px;
            background-color: var(--bs-gray-100);
        }

        .vp-vista-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 30px;
            height: 24px;
            border: 0;
            border-radius: 7px;
            background-color: transparent;
            color: var(--bs-gray-600);
            font-size: 0.75rem;
            transition: background-color 0.12s ease, color 0.12s ease;
        }

            .vp-vista-btn:hover {
                color: var(--vp-acento);
            }

            .vp-vista-btn.activo {
                background-color: var(--vp-panel-bg);
                color: var(--vp-acento);
                box-shadow: 0 1px 2px rgba(20, 20, 31, 0.12);
            }

        /* ---------- Listado lateral de cámaras ---------- */
        .vp-lista {
            display: flex;
            flex-direction: column;
            flex: 0 1 auto;
            max-height: var(--vp-lista-alto);
            min-height: 0;
        }

        .vp-lista-cuerpo {
            display: flex;
            flex-direction: column;
            gap: 0.4rem;
            padding: 0 0.6rem 0.6rem;
            overflow-y: auto;
            min-height: 0;
        }

        .vp-item {
            display: flex;
            align-items: center;
            gap: 0.65rem;
            width: 100%;
            padding: 0.55rem 0.6rem;
            border: 1px solid transparent;
            border-radius: 10px;
            background-color: transparent;
            text-align: left;
            cursor: pointer;
            transition: background-color 0.15s ease, border-color 0.15s ease;
        }

            .vp-item:hover {
                background-color: var(--bs-gray-100);
            }

            .vp-item.activo {
                background-color: rgba(var(--bs-primary-rgb), 0.08);
                border-color: rgba(var(--bs-primary-rgb), 0.35);
            }

        .vp-item-num {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 34px;
            height: 34px;
            flex-shrink: 0;
            border-radius: 99px;
            background-color: var(--bs-gray-200);
            color: var(--bs-gray-700);
            font-size: 0.875rem;
            font-weight: 700;
            line-height: 1;
        }

        .vp-item.activo .vp-item-num {
            background-color: var(--vp-acento);
            color: #ffffff;
        }

        .vp-item-texto {
            min-width: 0;
            flex: 1 1 auto;
        }

        .vp-item-nombre {
            display: block;
            font-size: 0.8125rem;
            font-weight: 600;
            color: var(--bs-gray-900);
            line-height: 1.25;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .vp-item-estado {
            display: flex;
            align-items: center;
            gap: 0.3rem;
            font-size: 0.6875rem;
            color: var(--bs-gray-500);
            line-height: 1.25;
        }

            .vp-item-estado::before {
                content: "";
                width: 6px;
                height: 6px;
                border-radius: 50%;
                background-color: currentColor;
                flex-shrink: 0;
            }

            .vp-item-estado[data-estado="vivo"] { color: var(--bs-success); }
            .vp-item-estado[data-estado="conectando"],
            .vp-item-estado[data-estado="cargando"] { color: var(--bs-warning); }
            .vp-item-estado[data-estado="error"] { color: var(--bs-danger); }

        .vp-chip-ptz {
            display: inline-flex;
            align-items: center;
            gap: 0.25rem;
            flex-shrink: 0;
            padding: 0.1rem 0.4rem;
            border: 1px solid var(--vp-panel-borde);
            border-radius: 6px;
            color: var(--bs-gray-600);
            font-size: 0.625rem;
            font-weight: 700;
            letter-spacing: 0.6px;
            line-height: 1.5;
        }

        .vp-item.activo .vp-chip-ptz {
            border-color: rgba(var(--bs-primary-rgb), 0.4);
            color: var(--vp-acento);
        }

        .vp-item[data-ptz="false"] .vp-chip-ptz {
            display: none;
        }

        .vp-item-config {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 26px;
            height: 26px;
            flex-shrink: 0;
            border: 0;
            border-radius: 7px;
            background-color: transparent;
            color: var(--bs-gray-500);
            transition: background-color 0.15s ease, color 0.15s ease;
        }

            .vp-item-config:hover {
                background-color: var(--bs-gray-200);
                color: var(--vp-acento);
            }

        /* ---------- Controles PTZ ---------- */
        .vp-controles {
            flex: 1 1 auto;
            min-height: 0;
            display: flex;
            flex-direction: column;
            position: relative;
        }

        .vp-seccion-cuerpo {
            display: flex;
            flex-direction: column;
            gap: 0.9rem;
            padding: 0 1rem 1rem;
            flex: 1 1 auto;
            min-height: 0;
            overflow-y: auto;
        }

        .vp-seccion-columna {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
            min-width: 0;
        }

            .vp-seccion-columna + .vp-seccion-columna {
                padding-top: 0.9rem;
                border-top: 1px dashed var(--vp-panel-borde);
            }

        .vp-seccion-subtitulo {
            font-size: 0.625rem;
            font-weight: 700;
            letter-spacing: 0.7px;
            text-transform: uppercase;
            color: var(--bs-gray-500);
        }

        .vp-ptz-objetivo {
            display: inline-flex;
            min-width: 0;
            align-items: center;
            gap: 0.35rem;
            padding: 0.15rem 0.5rem;
            border-radius: 999px;
            background-color: rgba(var(--bs-primary-rgb), 0.1);
            color: var(--vp-acento);
            font-size: 0.6875rem;
            font-weight: 700;
            white-space: nowrap;
        }

            .vp-ptz-objetivo > span {
                overflow: hidden;
                text-overflow: ellipsis;
            }

            .vp-ptz-objetivo i { flex-shrink: 0; }

        .vp-dpad {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 6px;
            width: 100%;
            max-width: 168px;
            margin-inline: auto;
        }

            .vp-dpad .vp-btn-control {
                aspect-ratio: 1;
            }

        .vp-btn-control {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.35rem;
            border: 1px solid var(--vp-panel-borde);
            border-radius: 9px;
            background-color: var(--bs-gray-100);
            color: var(--bs-gray-700);
            font-size: 0.75rem;
            font-weight: 600;
            padding: 0;
            transition: background-color 0.12s ease, color 0.12s ease, border-color 0.12s ease;
        }

            .vp-btn-control:hover:not(.vp-dpad-centro),
            .vp-btn-control:hover:not(.vp-dpad-centro) i,
            .vp-btn-control:hover:not(.vp-dpad-centro) svg {
                background-color: var(--vp-acento);
                border-color: var(--vp-acento);
                color: #ffffff;
                fill: currentColor;
            }

            .vp-btn-control:active {
                transform: scale(0.94);
            }

            .vp-btn-control.vp-dpad-centro {
                background-color: transparent;
                border-style: dashed;
            }

                .vp-btn-control.vp-dpad-centro:hover {
                    border-color: var(--vp-acento);
                }

        .vp-ptz-pares {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 0.5rem;
        }

        .vp-ptz-par {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 4px;
        }

        .vp-ptz-par-nombre {
            grid-column: 1 / -1;
            text-align: center;
            font-size: 0.625rem;
            font-weight: 600;
            color: var(--bs-gray-600);
        }

        .vp-ptz-par .vp-btn-control {
            min-width: 0;
            height: 30px;
        }

        .vp-ptz-etiqueta {
            display: flex;
            justify-content: space-between;
            font-size: 0.6875rem;
            font-weight: 600;
            color: var(--bs-gray-500);
        }

        .vp-ptz-velocidad input[type="range"] {
            -webkit-appearance: none;
            appearance: none;
            width: 100%;
            height: 16px;
            margin: 0;
            background: transparent;
            cursor: pointer;
        }

            .vp-ptz-velocidad input[type="range"]::-webkit-slider-runnable-track {
                height: 6px;
                border-radius: 999px;
                background: linear-gradient(to right, var(--vp-acento) 0 var(--vp-relleno, 50%), var(--vp-panel-borde) var(--vp-relleno, 50%) 100%);
            }

            .vp-ptz-velocidad input[type="range"]::-webkit-slider-thumb {
                -webkit-appearance: none;
                appearance: none;
                width: 14px;
                height: 14px;
                margin-top: -4px;
                border: 0;
                border-radius: 50%;
                background-color: var(--vp-acento);
            }

            .vp-ptz-velocidad input[type="range"]::-moz-range-track {
                height: 6px;
                border-radius: 999px;
                background-color: var(--vp-panel-borde);
            }

            .vp-ptz-velocidad input[type="range"]::-moz-range-progress {
                height: 6px;
                border-radius: 999px;
                background-color: var(--vp-acento);
            }

            .vp-ptz-velocidad input[type="range"]::-moz-range-thumb {
                width: 14px;
                height: 14px;
                border: 0;
                border-radius: 50%;
                background-color: var(--vp-acento);
            }

        .vp-funciones {
            display: grid;
            gap: 0.35rem;
        }

        .vp-toggle {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            height: 32px;
            padding: 0 0.55rem;
            border: 1px solid var(--vp-panel-borde);
            border-radius: 8px;
            background-color: var(--bs-gray-100);
            color: var(--bs-gray-700);
            font-size: 0.6875rem;
            font-weight: 600;
            white-space: nowrap;
            overflow: hidden;
            transition: background-color 0.12s ease, color 0.12s ease, border-color 0.12s ease;
        }

            .vp-toggle:hover,
            .vp-toggle:hover i,
            .vp-toggle:hover svg {
                border-color: var(--vp-acento);
                color: var(--vp-acento);
                fill: currentColor;
            }

            .vp-toggle.activo {
                background-color: rgba(var(--bs-success-rgb), 0.12);
                border-color: rgba(var(--bs-success-rgb), 0.45);
                color: var(--bs-success);
            }

            .vp-toggle i { flex-shrink: 0; }

        .vp-controles[data-disponible="false"] .vp-seccion-columna {
            opacity: 0.3;
            pointer-events: none;
            filter: grayscale(1);
        }

        .vp-seccion-aviso {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            z-index: 3;
            display: none;
            align-items: center;
            pointer-events: none;
            gap: 0.5rem;
            max-width: calc(100% - 2rem);
            padding: 0.6rem 0.85rem;
            border: 1px dashed var(--vp-panel-borde);
            border-radius: 9px;
            background-color: var(--vp-panel-bg);
            box-shadow: var(--vp-sombra);
            font-size: 0.75rem;
            font-weight: 500;
            color: var(--bs-gray-700);
        }

        .vp-controles[data-disponible="false"] .vp-seccion-aviso {
            display: flex;
        }

        .vp-ptz-badge {
            padding: 0.15rem 0.5rem;
            border-radius: 6px;
            font-size: 0.625rem;
            font-weight: 700;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            background-color: rgba(var(--bs-success-rgb), 0.12);
            color: var(--bs-success);
            flex-shrink: 0;
        }

        .vp-controles[data-disponible="false"] .vp-ptz-badge {
            background-color: var(--bs-gray-200);
            color: var(--bs-gray-500);
        }

        @@media (max-width: 1500px) {
            :root {
                --vp-lateral-ancho: 270px;
            }

            .vp-dpad {
                grid-template-columns: repeat(3, 34px);
                grid-template-rows: repeat(3, 34px);
            }

            .vp-seccion-cuerpo {
                gap: 0.7rem;
            }

                .vp-seccion-cuerpo .vp-seccion-columna + .vp-seccion-columna {
                    padding-top: 0.7rem;
                }
        }
    </style>
    <!--end::Videowall-->
}

