@section Scripts {
    <script>
        async function delay(milisegundos) {
            return new Promise((resolve, reject) => {
                setTimeout(resolve, milisegundos);
            })
        }

        const CAMARAS = {
            1: { nombre: "Cámara 1 · Frontal", stream: "camara_1", ptz: true, audio: false },
            2: { nombre: "Cámara 2 · Lateral", stream: "camara_2", ptz: false, audio: false },
            3: { nombre: "Cámara 3 · Trasera", stream: "camara_3", ptz: true, audio: true },
            4: { nombre: "Cámara 4 · Interior", stream: "camara_4", ptz: false, audio: false },
            5: { nombre: "Cámara 5", stream: "camara_5", ptz: false, audio: false },
            6: { nombre: "Cámara 6", stream: "camara_6", ptz: false, audio: false }
        };

        function TextoHtml(valor) {
            return String(valor ?? "").replace(/[&<>"]/g, caracter => ({
                "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;"
            }[caracter]));
        }

        function CeldaHtml(numero, camara) {
            const nombre = TextoHtml(camara.nombre ?? `Cámara ${numero}`);

            return `
                <div class="vp-celda" data-camara="${numero}">
                    <div class="vp-celda-vacia">
                        <i class="ki-outline ki-screen fs-3x"></i>
                        <span class="fs-7 fw-semibold">Conectando…</span>
                    </div>

                    <div class="vp-celda-capa" title="Seleccionar esta cámara"></div>

                    <div class="vp-celda-barra">
                        <span class="vp-celda-num">${numero}</span>
                        <span class="vp-celda-nombre">${nombre}</span>
                        <span class="vp-vivo" data-estado="conectando" title="Conectando">Conectando</span>

                        <div class="vp-celda-acciones">
                            <div class="vp-celda-volumen">
                                <button type="button" class="vp-celda-btn" data-accion="silencio" title="Activar sonido">
                                    <i class="fas fa-volume-mute"></i>
                                </button>
                                <input type="range" class="vp-celda-volumen-barra" min="0" max="100" step="1" value="100"
                                    title="Volumen" aria-label="Volumen" />
                            </div>
                            <button type="button" class="vp-celda-btn" data-accion="capturar" title="Capturar imagen">
                                <i class="ki-outline ki-picture fs-5"></i>
                            </button>
                            <button type="button" class="vp-celda-btn" data-accion="pantalla-completa" title="Pantalla completa">
                                <i class="fas fa-expand"></i>
                            </button>
                        </div>
                    </div>
                </div>`;
        }

        function ItemHtml(numero, camara) {
            const nombre = TextoHtml(camara.nombre ?? `Cámara ${numero}`);

            return `
                <div class="vp-item" role="button" tabindex="0" data-camara="${numero}"
                    data-ptz="${camara.ptz ? "true" : "false"}" data-nombre="${nombre}">
                    <span class="vp-item-num">${numero}</span>
                    <span class="vp-item-texto">
                        <span class="vp-item-nombre">${nombre}</span>
                        <span class="vp-item-estado" data-estado="conectando">Conectando</span>
                    </span>
                    <span class="vp-chip-ptz" title="Cámara con control PTZ">PTZ</span>
                    <button type="button" class="vp-item-config" data-accion="configurar"
                        title="Configurar cámara">
                        <i class="ki-outline ki-setting-2 fs-5"></i>
                    </button>
                </div>`;
        }

        function PintarCamaras() {
            const visor = document.getElementById("visor");
            const lista = document.getElementById("lista-camaras");
            const numeros = Object.keys(CAMARAS);

            visor.innerHTML = numeros.map(numero => CeldaHtml(numero, CAMARAS[numero])).join("");
            lista.innerHTML = numeros.map(numero => ItemHtml(numero, CAMARAS[numero])).join("");

            visor.style.setProperty("--vp-tira", String(Math.max(numeros.length - 1, 1)));

            visor.querySelector(".vp-celda")?.classList.add("seleccionada");
            lista.querySelector(".vp-item")?.classList.add("activo");
        }

        PintarCamaras();

        const MODO_PRUEBAS = true;
        const GO2RTC_URL = "https://localhost:7037/api/video/streaming/";

        const COMPONENTE_LISTO = import(new URL("video-stream.js", GO2RTC_URL).href);

        let AlMontarCamara = null;

        async function MontarCamara(celda, stream) {
            if (!celda) return;

            if (!stream) {
                console.warn("Sin stream de go2rtc para la cámara", celda.dataset.camara);
                return;
            }

            await COMPONENTE_LISTO;

            celda.querySelector("video-stream")?.remove();

            const reproductor = document.createElement("video-stream");

            reproductor.background = false;
            reproductor.visibilityCheck = false;
            reproductor.visibilityThreshold = 0;

            reproductor.origen = new URL("api/ws?src=" + encodeURIComponent(stream), GO2RTC_URL);

            if (celda.offsetParent === null) reproductor.detenido = true;
            else reproductor.src = reproductor.origen;

            celda.insertBefore(reproductor, celda.querySelector(".vp-celda-capa"));

            if (AlMontarCamara) AlMontarCamara(celda);
        }

        function StreamDeUrl(url) {
            try {
                return new URL(url, location.href).searchParams.get("src");
            } catch {
                return null;
            }
        }

        async function IniciarCamaras() {
            if (MODO_PRUEBAS) {
                document.querySelectorAll(".vp-celda").forEach(celda => {
                    MontarCamara(celda, CAMARAS[celda.dataset.camara]?.stream);
                });

                return;
            }

            const CAMARAS_ENDPOINTS = await FetchUtils('camaras', {
                method: "GET",
            }).then(resp => {
                if (!resp || !resp.Ok || !resp.Respuesta || resp.Respuesta.length == 0) return [];

                return resp.Respuesta
                    .filter(el => el.Activo)
                    .map(el => el.StreamingUrl);
            })

            CAMARAS_ENDPOINTS.map(async (src, index) => {
                let reintentarConexion = true;

                while (reintentarConexion) {
                    try {
                        await fetch(src, { mode: 'no-cors' });
                        reintentarConexion = false;
                    } catch {
                        await delay(5000)
                    }
                }

                MontarCamara(document.querySelector(`.vp-celda[data-camara="${index + 1}"]`), StreamDeUrl(src));
            });
        };

        IniciarCamaras();
    </script>

    <script>
        async function ReiniciarCamaras(self) {
            self.disabled = true;
            try {
                await fetch("http://localhost:1984/api/exit?code=100", { method: "POST", mode: 'no-cors' });
            } finally {
                setTimeout(IniciarCamaras, 5000);
                setTimeout(() => {
                    self.disabled = false;
                }, 15000)
            }
        }
    </script>

    <script>
        (function () {
            const visor = document.getElementById("visor");
            const lista = document.getElementById("lista-camaras");
            const vistaToggle = document.getElementById("vista-toggle");

            const controles = document.getElementById("panel-controles");
            const ptzEstado = document.getElementById("ptz-estado");
            const ptzObjetivo = document.getElementById("ptz-objetivo-nombre");
            const ptzVelocidad = document.getElementById("ptz-velocidad");
            const ptzVelocidadValor = document.getElementById("ptz-velocidad-valor");

            const celdas = visor.querySelectorAll(".vp-celda");
            const items = lista.querySelectorAll(".vp-item");

            function SeleccionarCamara(numero) {
                const item = lista.querySelector(`.vp-item[data-camara="${numero}"]`);
                if (!item) return;

                items.forEach(el => el.classList.toggle("activo", el === item));

                item.scrollIntoView({ block: "nearest", behavior: "smooth" });
                celdas.forEach(el => el.classList.toggle("seleccionada", el.dataset.camara === numero));

                ptzObjetivo.innerText = item.dataset.nombre ?? "";

                const tienePtz = item.dataset.ptz === "true";
                controles.dataset.disponible = tienePtz ? "true" : "false";
                ptzEstado.innerText = tienePtz ? "Disponible" : "No disponible";

                controles.querySelectorAll(".vp-seccion-columna")
                    .forEach(seccion => seccion.toggleAttribute("inert", !tienePtz));

                SincronizarTransmisiones();
            }

            function CambiarVista(vista) {
                visor.dataset.vista = vista;
                vistaToggle.querySelectorAll(".vp-vista-btn")
                    .forEach(el => el.classList.toggle("activo", el.dataset.vista === vista));

                SincronizarTransmisiones();
            }

            items.forEach(item => {
                item.addEventListener("click", () => SeleccionarCamara(item.dataset.camara));

                item.addEventListener("keydown", evento => {
                    if (evento.key !== "Enter" && evento.key !== " ") return;

                    evento.preventDefault();
                    SeleccionarCamara(item.dataset.camara);
                });
            });

            const modalCamara = new bootstrap.Modal(document.getElementById("modal-camara"));
            const modalTitulo = document.getElementById("modal-camara-titulo");
            const configNombre = document.getElementById("config-nombre");
            const configStream = document.getElementById("config-stream");
            const configPtz = document.getElementById("config-ptz");
            const configAudio = document.getElementById("config-audio");

            let camaraEnConfiguracion = null;

            document.querySelectorAll("[data-accion='configurar']").forEach(boton => {
                boton.addEventListener("click", evento => {
                    evento.stopPropagation();

                    const item = boton.closest(".vp-item");
                    const numero = item.dataset.camara;

                    camaraEnConfiguracion = numero;

                    modalTitulo.innerText = item.dataset.nombre ?? "Configurar cámara";
                    configNombre.value = item.dataset.nombre ?? "";
                    configStream.value = CAMARAS[numero]?.stream ?? "";
                    configPtz.checked = item.dataset.ptz === "true";
                    configAudio.checked = !!CAMARAS[numero]?.audio;

                    modalCamara.show();
                });
            });

            document.getElementById("config-guardar").addEventListener("click", () => {
                const numero = camaraEnConfiguracion;
                if (!numero) return;

                const item = lista.querySelector(`.vp-item[data-camara="${numero}"]`);
                const celda = visor.querySelector(`.vp-celda[data-camara="${numero}"]`);
                const nombre = configNombre.value.trim() || item.dataset.nombre;

                item.dataset.nombre = nombre;
                item.querySelector(".vp-item-nombre").innerText = nombre;
                item.dataset.ptz = configPtz.checked ? "true" : "false";

                if (celda) {
                    celda.querySelector(".vp-celda-nombre").innerText = nombre;
                    celda.dataset.audio = configAudio.checked ? "true" : "false";
                }

                if (CAMARAS[numero]) {
                    CAMARAS[numero].nombre = nombre;
                    CAMARAS[numero].stream = configStream.value.trim();
                    CAMARAS[numero].ptz = configPtz.checked;
                    CAMARAS[numero].audio = configAudio.checked;
                }

                if (item.classList.contains("activo")) SeleccionarCamara(numero);

                modalCamara.hide();
            });

            celdas.forEach(celda => {
                celda.addEventListener("click", () => {
                    if (visor.dataset.vista !== "previa") return;
                    SeleccionarCamara(celda.dataset.camara);
                });
            });

            vistaToggle.querySelectorAll(".vp-vista-btn").forEach(boton => {
                boton.addEventListener("click", () => CambiarVista(boton.dataset.vista));
            });

            SeleccionarCamara(lista.querySelector(".vp-item.activo").dataset.camara);

            document.querySelectorAll("[data-ptz-funcion]").forEach(boton => {
                boton.addEventListener("click", () => boton.classList.toggle("activo"));
            });

            function PintarVelocidad() {
                const recorrido = (ptzVelocidad.value - ptzVelocidad.min) / (ptzVelocidad.max - ptzVelocidad.min);

                ptzVelocidad.style.setProperty("--vp-relleno", `${recorrido * 100}%`);
                ptzVelocidadValor.innerText = ptzVelocidad.value;
            }

            ptzVelocidad.addEventListener("input", PintarVelocidad);
            PintarVelocidad();

            function ReproductorDe(celda) {
                return celda ? celda.querySelector("video-stream") : null;
            }

            function VideoDe(celda) {
                return ReproductorDe(celda)?.video ?? null;
            }

            function PrepararVideo(reproductor) {
                const video = reproductor.video;
                if (!video) return;

                video.controls = false;

                if (!video.dataset.iniciado) {
                    video.dataset.iniciado = "1";
                    video.muted = true;
                }
            }

            const ESTADOS_CELDA = {
                vivo: "En vivo",
                conectando: "Conectando",
                cargando: "Cargando",
                pausado: "Pausado",
                detenido: "Detenido",
                error: "Sin señal"
            };

            function ActualizarEstadoCelda(celda, estado, detalle) {
                const indicador = celda.querySelector(".vp-vivo");
                if (!indicador) return;

                if (ReproductorDe(celda)?.detenido && estado !== "detenido") return;

                const texto = ESTADOS_CELDA[estado] ?? ESTADOS_CELDA.error;

                indicador.dataset.estado = estado in ESTADOS_CELDA ? estado : "error";
                indicador.innerText = texto;
                indicador.title = detalle ? `${texto} · ${detalle}` : texto;

                const enListado = lista.querySelector(`.vp-item[data-camara="${celda.dataset.camara}"] .vp-item-estado`);

                if (enListado) {
                    enListado.dataset.estado = indicador.dataset.estado;
                    enListado.innerText = texto;
                }
            }

            function LeerEstado(celda) {
                const reproductor = ReproductorDe(celda);
                const modo = reproductor?.querySelector(".mode")?.innerText.trim();

                if (!modo) return false;

                if (modo === "error") {
                    ActualizarEstadoCelda(celda, "error", reproductor.querySelector(".status")?.innerText.trim());
                } else if (modo !== "loading") {
                    ActualizarEstadoCelda(celda, "vivo", modo);
                } else {
                    const video = reproductor.video;
                    const corriendo = video && !video.paused && video.readyState >= 2;

                    ActualizarEstadoCelda(celda, corriendo ? "vivo" : "conectando");
                }

                return true;
            }

            function DetenerCamara(celda) {
                const reproductor = ReproductorDe(celda);
                if (!reproductor || reproductor.detenido) return;

                reproductor.detenido = true;
                reproductor.disconnectedCallback();
            }

            function ReanudarCamara(celda) {
                const reproductor = ReproductorDe(celda);
                if (!reproductor || !reproductor.detenido) return;

                reproductor.detenido = false;

                if (!reproductor.wsURL) reproductor.src = reproductor.origen;
                else reproductor.connectedCallback();

                if (!LeerEstado(celda)) ActualizarEstadoCelda(celda, "conectando");
            }

            function SincronizarTransmisiones() {
                celdas.forEach(celda => {
                    if (celda.offsetParent !== null) ReanudarCamara(celda);
                    else DetenerCamara(celda);
                });
            }

            function ActualizarVolumen(celda) {
                const video = VideoDe(celda);
                if (!video) return;

                const barra = celda.querySelector(".vp-celda-volumen-barra");
                if (barra) barra.value = Math.round(video.volume * 100);

                const boton = celda.querySelector("[data-accion='silencio']");
                if (!boton) return;

                boton.title = video.muted ? "Activar sonido" : "Silenciar";
                boton.querySelector("i").className = video.muted || video.volume === 0
                    ? "fas fa-volume-mute"
                    : video.volume < 0.5 ? "fas fa-volume-down" : "fas fa-volume-up";
            }

            function AlternarSilencio(celda) {
                const video = VideoDe(celda);
                if (!video) return;

                video.muted = !video.muted;
                if (!video.muted) ReproductorDe(celda).play();
            }

            function FijarVolumen(celda, porcentaje) {
                const video = VideoDe(celda);
                if (!video) return;

                video.volume = porcentaje / 100;
                if (porcentaje > 0) video.muted = false;
            }

            document.querySelectorAll("[data-accion='silencio']").forEach(boton => {
                boton.addEventListener("click", () => AlternarSilencio(boton.closest(".vp-celda")));
            });

            document.querySelectorAll(".vp-celda-volumen-barra").forEach(barra => {
                barra.addEventListener("input", () => FijarVolumen(barra.closest(".vp-celda"), barra.value));
            });

            function NombreCaptura(celda) {
                const nombre = (celda.querySelector(".vp-celda-nombre")?.innerText ?? "camara")
                    .normalize("NFD").replace(/[̀-ͯ]/g, "")
                    .toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");

                const ahora = new Date();
                const dosDigitos = valor => String(valor).padStart(2, "0");
                const marca = `${ahora.getFullYear()}${dosDigitos(ahora.getMonth() + 1)}${dosDigitos(ahora.getDate())}`
                    + `-${dosDigitos(ahora.getHours())}${dosDigitos(ahora.getMinutes())}${dosDigitos(ahora.getSeconds())}`;

                return `${nombre || "camara"}-${marca}.jpg`;
            }

            function CuadroActual(celda) {
                const video = VideoDe(celda);
                if (!video) return null;

                if (!video.videoWidth || !video.videoHeight) return video.poster || null;

                const lienzo = document.createElement("canvas");
                lienzo.width = video.videoWidth;
                lienzo.height = video.videoHeight;
                lienzo.getContext("2d").drawImage(video, 0, 0);

                return lienzo.toDataURL("image/jpeg", 0.92);
            }

            document.querySelectorAll("[data-accion='capturar']").forEach(boton => {
                boton.addEventListener("click", () => {
                    const celda = boton.closest(".vp-celda");
                    const imagen = CuadroActual(celda);

                    if (!imagen) {
                        SwalUtils.error({
                            title: "Sin imagen",
                            text: "Todavía no hay un cuadro de esta cámara para capturar.",
                            confirmButtonText: "Aceptar"
                        });
                        return;
                    }

                    const enlace = document.createElement("a");
                    enlace.href = imagen;
                    enlace.download = NombreCaptura(celda);
                    enlace.click();

                    celda.classList.add("vp-capturando");
                    setTimeout(() => celda.classList.remove("vp-capturando"), 400);
                });
            });

            celdas.forEach(celda => {
                celda.dataset.audio = CAMARAS[celda.dataset.camara]?.audio ? "true" : "false";
            });

            function ConectarCelda(celda) {
                const reproductor = ReproductorDe(celda);
                if (!reproductor || reproductor.conectado) return;

                reproductor.conectado = true;
                PrepararVideo(reproductor);

                reproductor.addEventListener("volumechange", () => ActualizarVolumen(celda), true);
                reproductor.addEventListener("waiting", () => ActualizarEstadoCelda(celda, "cargando"), true);
                reproductor.addEventListener("stalled", () => ActualizarEstadoCelda(celda, "cargando"), true);
                reproductor.addEventListener("pause", () => ActualizarEstadoCelda(celda, "pausado"), true);
                reproductor.addEventListener("playing", () => LeerEstado(celda), true);
                reproductor.addEventListener("error", () => ActualizarEstadoCelda(celda, "error", "Falló la reproducción"), true);

                const Desconectar = reproductor.ondisconnect.bind(reproductor);

                reproductor.ondisconnect = () => {
                    Desconectar();
                    if (reproductor.detenido) ActualizarEstadoCelda(celda, "detenido");
                };

                new MutationObserver(() => {
                    PrepararVideo(reproductor);
                    LeerEstado(celda);
                }).observe(reproductor, {
                    childList: true,
                    subtree: true,
                    characterData: true,
                    attributes: true,
                    attributeFilter: ["controls"]
                });

                ActualizarVolumen(celda);

                if (reproductor.detenido) ActualizarEstadoCelda(celda, "detenido");
                else if (!LeerEstado(celda)) ActualizarEstadoCelda(celda, "conectando");
            }

            AlMontarCamara = ConectarCelda;
            celdas.forEach(celda => ConectarCelda(celda));

            function CeldaEnPantallaCompleta() {
                return document.fullscreenElement || document.webkitFullscreenElement || null;
            }

            document.querySelectorAll("[data-accion='pantalla-completa']").forEach(boton => {
                boton.addEventListener("click", () => {
                    const celda = boton.closest(".vp-celda");
                    if (!celda) return;

                    if (CeldaEnPantallaCompleta()) {
                        (document.exitFullscreen || document.webkitExitFullscreen).call(document);
                        return;
                    }

                    const solicitar = celda.requestFullscreen || celda.webkitRequestFullscreen;
                    if (solicitar) solicitar.call(celda);
                });
            });

            function ActualizarIconosPantallaCompleta() {
                const activa = CeldaEnPantallaCompleta();

                document.querySelectorAll("[data-accion='pantalla-completa']").forEach(boton => {
                    const celda = boton.closest(".vp-celda");
                    const maximizada = activa !== null && celda === activa;

                    boton.title = maximizada ? "Salir de pantalla completa" : "Pantalla completa";
                    boton.querySelector("i").className = maximizada ? "fas fa-compress" : "fas fa-expand";
                });
            }

            document.addEventListener("fullscreenchange", ActualizarIconosPantallaCompleta);
            document.addEventListener("webkitfullscreenchange", ActualizarIconosPantallaCompleta);
        })();
    </script>
}